<UserControl x:Class="AlchemyStars.Avalonia.CastPreviewView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlchemyStars.Avalonia" x:DataType="local:CastPreviewViewModel">
  <Grid RowDefinitions="*,56">
    <Grid ColumnDefinitions="40,*">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Background="{DynamicResource AlchemySurfaceBrush}" IsEnabled="{Binding HasScene}">
          <ToggleButton Classes="preview-command compact-preview-command" IsChecked="{Binding IsFirstPerson, Mode=OneWay}" Click="FirstPersonClick"
              ToolTip.Tip="{Binding CameraModeLabel}" AutomationProperties.Name="{Binding CameraModeLabel}">
            <Grid>
              <Image RenderOptions.BitmapInterpolationMode="HighQuality" Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/camera-view.png" Stretch="Uniform" IsHitTestVisible="False" IsVisible="{Binding !IsFirstPerson}" />
              <Image RenderOptions.BitmapInterpolationMode="HighQuality" Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/camera-view.png" Stretch="Uniform" IsHitTestVisible="False" IsVisible="{Binding IsFirstPerson}" />
            </Grid>
          </ToggleButton>
          <Button x:Name="FitButton" Classes="panel-command compact-preview-command" Click="FitClick" ToolTip.Tip="{Binding Text.FitPreview}" AutomationProperties.Name="{Binding Text.FitPreview}"><Button.ContextMenu><ContextMenu><MenuItem Header="{Binding Text.FitSubjectMenu}" Click="FitClick" /><MenuItem Header="{Binding Text.FitAllGeometryMenu}" Click="FitAllClick" /></ContextMenu></Button.ContextMenu><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/fit-view.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" Width="17" Height="17" /></Button>
          <Button Classes="panel-command compact-preview-command" IsEnabled="{Binding CanAdjustCamera}" Click="ZoomInClick" ToolTip.Tip="{Binding Text.ZoomIn}" AutomationProperties.Name="{Binding Text.ZoomIn}"><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/zoom-in.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" Width="17" Height="17" /></Button>
          <Button Classes="panel-command compact-preview-command" IsEnabled="{Binding CanAdjustCamera}" Click="ZoomOutClick" ToolTip.Tip="{Binding Text.ZoomOut}" AutomationProperties.Name="{Binding Text.ZoomOut}"><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/zoom-out.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" Width="17" Height="17" /></Button>
          <Button Classes="panel-command compact-preview-command" Click="BonesClick" ToolTip.Tip="{Binding Text.ShowBones}" AutomationProperties.Name="{Binding Text.ShowBones}"><Image RenderOptions.BitmapInterpolationMode="HighQuality" Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/inverse-kinematics.png" Stretch="Uniform" IsHitTestVisible="False" /></Button>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="Viewport" Grid.Column="1" Background="{DynamicResource AlchemyCanvasBrush}" Focusable="True" ClipToBounds="True"
          SizeChanged="ViewportSizeChanged" PointerPressed="ViewportPressed" PointerMoved="ViewportMoved" PointerReleased="ViewportReleased"
          PointerWheelChanged="ViewportWheel" KeyDown="ViewportKeyDown" ToolTip.Tip="{Binding InteractionHelp}"
          AutomationProperties.Name="{Binding InteractionHelp}">
        <Grid>
          <local:GpuCastPreviewControl Frame="{Binding FrameData}" IsVisible="{Binding HasScene}" AutomationProperties.Name="{Binding Status}" />
          <StackPanel IsVisible="{Binding !HasScene}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Spacing="14">
            <Image Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/cast-preview.png" Width="52" Height="52" Stretch="Uniform" />
            <TextBlock Text="{Binding Status}" TextAlignment="Center" TextWrapping="Wrap" Classes="muted" MaxWidth="400" />
          </StackPanel>
          <Border VerticalAlignment="Bottom" Padding="7,3" Background="{DynamicResource AlchemyCanvasBrush}" IsVisible="{Binding HasScene}" IsHitTestVisible="False">
            <TextBlock Text="{Binding Source}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Border>
          <Border VerticalAlignment="Top" Padding="7,3" Background="{DynamicResource AlchemyCanvasBrush}" IsVisible="{Binding HasScene}" IsHitTestVisible="False">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="preview-badge compact-preview-badge" Margin="7,0,0,0" IsVisible="{Binding IsFirstPerson}">
                <TextBlock Text="{Binding FirstPersonBadge}" Foreground="{DynamicResource AlchemyAccentBrush}" FontSize="10" FontWeight="SemiBold" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource AlchemySurfaceBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="24,32">
        <Slider x:Name="FrameSlider" Classes="preview-scrubber" Minimum="0" Maximum="{Binding LastFrame}"
          Value="{Binding Frame}" SmallChange="1" IsSnapToTickEnabled="True" TickPlacement="TopLeft"
          TickFrequency="{Binding PreviewTickFrequency}" Margin="10,-2,10,0"
          IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{Binding Text.PreviewFrame}">
        <Slider.Resources>
          <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
          <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
          <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
          <x:Double x:Key="SliderOutsideTickBarThemeHeight">6</x:Double>
          <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
          <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource AlchemyAccent}" />
          <SolidColorBrush x:Key="SliderTickBarFill" Color="{DynamicResource AlchemyMutedText}" />
        </Slider.Resources>
        </Slider>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
          <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanPlay}">
            <Button Classes="panel-command preview-transport-command" Click="PreviousClick" ToolTip.Tip="{Binding Text.PreviousFrame}" AutomationProperties.Name="{Binding Text.PreviousFrame}"><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/previous-frame.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" Width="15" Height="15" /></Button>
            <Button Classes="panel-command preview-transport-command" Click="PlayClick" ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}"><Grid><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/play.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" IsVisible="{Binding !IsPlaying}" Width="15" Height="15" /><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/pause.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" IsVisible="{Binding IsPlaying}" Width="15" Height="15" /></Grid></Button>
            <Button Classes="panel-command preview-transport-command" Click="NextClick" ToolTip.Tip="{Binding Text.NextFrame}" AutomationProperties.Name="{Binding Text.NextFrame}"><Image Classes="product-icon" Source="avares://AlchemyStars.Avalonia/Assets/AppleBlue/next-frame.png" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" IsHitTestVisible="False" Width="15" Height="15" /></Button>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding FrameLabel}" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0"
              VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{Binding Status}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
