<Window x:Class="Alchemist.UI.AppMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding DialogTitle}"
        AutomationProperties.AutomationId="AppMessageWindow"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeToContent="Height"
        Width="480"
        MaxWidth="560"
        MinHeight="180"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="32" Height="32" Foreground="{Binding IconBrush}" VerticalAlignment="Top"/>
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/>
                <TextBox Grid.Row="1" Text="{Binding Message, Mode=OneWay}" AutomationProperties.AutomationId="AppMessageText"
                         Margin="0,10,0,0" Padding="0" TextWrapping="Wrap" MaxHeight="280"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                         Background="Transparent" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Grid>
        <Button Grid.Row="1" Content="{DynamicResource Close}" AutomationProperties.AutomationId="AppMessageCloseButton" MinWidth="80" Height="44" Margin="0,20,0,0" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="CloseClick" Style="{StaticResource MaterialDesignFlatButton}"/>
    </Grid>
</Window>
