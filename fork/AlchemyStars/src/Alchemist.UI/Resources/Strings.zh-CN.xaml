    <sys:String x:Key="AboutLicense">主程序许可证</sys:String>
    <sys:String x:Key="AboutUpstream">上游项目</sys:String>
    <sys:String x:Key="AboutOpenUpstream">打开 Alchemist 项目主页</sys:String>
    <sys:String x:Key="AboutCopyright">炼金之星是 Alchemist 的社区改进版本。Alchemist、RedFox 和 Maya CAST 组件的版权与许可证归各自项目所有；完整许可证和第三方声明已包含在发布包中。</sys:String>
