<Application
    x:Class="AlchemyStars.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Noto Sans CJK SC, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource AlchemyBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyPressedBrush}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="Foreground" Value="#FF0E0E0F" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Width" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.panel-command">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Width" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.activity">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity.selected">
      <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.activity.selected Path.icon-glyph.muted">
      <Setter Property="Stroke" Value="{DynamicResource AlchemyAccentBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyErrorBrush}" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.dock-panel">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.dock-header">
      <Setter Property="Height" Value="44" />
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.workspace-panel">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
    </Style>
    <Style Selector="Border.composition-canvas">
      <Setter Property="Background" Value="{DynamicResource AlchemyCanvasBrush}" />
    </Style>

    <Style Selector="Border.inspector-section">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.editor-card">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.subcard">
      <Setter Property="Background" Value="{DynamicResource AlchemySubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="Border.dropzone">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.dropzone:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
    </Style>
    <Style Selector="Border.hero-card">
      <Setter Property="Background" Value="{DynamicResource AlchemyHeroBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.dialog-card">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="BoxShadow" Value="0 16 40 0 #A0000000" />
    </Style>
    <Style Selector="Border.count-badge">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.feature-icon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#1A4CC2FF" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.preview-badge">
      <Setter Property="Background" Value="#1A4CC2FF" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBox:pointerover, ComboBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox:focus-within, ComboBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,0,0,5" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dock-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.rail-label">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>

    <Style Selector="Path.icon-glyph">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource AlchemyTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.icon-glyph.muted"><Setter Property="Stroke" Value="{DynamicResource AlchemyMutedTextBrush}" /></Style>
    <Style Selector="Path.icon-glyph.on-accent"><Setter Property="Stroke" Value="#FF0E0E0F" /></Style>
    <Style Selector="Path.icon-glyph.accent"><Setter Property="Stroke" Value="{DynamicResource AlchemyAccentBrush}" /></Style>
    <Style Selector="Path.icon-glyph.danger-glyph"><Setter Property="Stroke" Value="{DynamicResource AlchemyErrorBrush}" /></Style>

    <Style Selector="Expander.property-group">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,0,14,14" />
    </Style>
    <Style Selector="Expander.property-group /template/ ToggleButton">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.canvas-footer">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.track-heading">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,5" />
    </Style>
    <Style Selector="Border.track-heading TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
    <Style Selector="Border.track-row">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="Border.clip">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.base-clip">
      <Setter Property="Background" Value="{DynamicResource AlchemyBaseClipBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBaseEdgeBrush}" />
    </Style>
    <Style Selector="Border.layer-clip">
      <Setter Property="Background" Value="{DynamicResource AlchemyLayerClipBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyLayerEdgeBrush}" />
    </Style>
    <Style Selector="ListBox.asset-list, ListBox.track-list">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.asset-list ListBoxItem, ListBox.track-list ListBoxItem">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ListBox.track-list ListBoxItem">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="GridSplitter:pointerover, GridSplitter:focus-visible">
      <Setter Property="Background" Value="{DynamicResource AlchemyFocusBrush}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <!-- Reference-driven neutral creative editor; color distinguishes composition layers, not duration. -->
    <Color x:Key="AlchemyBackground">#FF202020</Color>
    <Color x:Key="AlchemySidebar">#FF252525</Color>
    <Color x:Key="AlchemyCommandBar">#FF222222</Color>
    <Color x:Key="AlchemyCanvas">#FF03060C</Color>
    <Color x:Key="AlchemySurface">#FF222222</Color>
    <Color x:Key="AlchemySubtleSurface">#FF262626</Color>
    <Color x:Key="AlchemySurfaceRaised">#FF2D2D2D</Color>
    <Color x:Key="AlchemyBorder">#FF383838</Color>
    <Color x:Key="AlchemyBorderStrong">#FF62656D</Color>
    <Color x:Key="AlchemyAccent">#FF4CC2FF</Color>
    <Color x:Key="AlchemyFocus">#FF60CDFF</Color>
    <Color x:Key="AlchemyText">#FFF5F5F5</Color>
    <Color x:Key="AlchemyMutedText">#FFB8BAC0</Color>
    <SolidColorBrush x:Key="AlchemyBackgroundBrush" Color="{StaticResource AlchemyBackground}" />
    <SolidColorBrush x:Key="AlchemySidebarBrush" Color="{StaticResource AlchemySidebar}" />
    <SolidColorBrush x:Key="AlchemyCommandBarBrush" Color="{StaticResource AlchemyCommandBar}" />
    <SolidColorBrush x:Key="AlchemyCanvasBrush" Color="{StaticResource AlchemyCanvas}" />
    <SolidColorBrush x:Key="AlchemySurfaceBrush" Color="{StaticResource AlchemySurface}" />
    <SolidColorBrush x:Key="AlchemySubtleSurfaceBrush" Color="{StaticResource AlchemySubtleSurface}" />
    <SolidColorBrush x:Key="AlchemySurfaceRaisedBrush" Color="{StaticResource AlchemySurfaceRaised}" />
    <SolidColorBrush x:Key="AlchemyBorderBrush" Color="{StaticResource AlchemyBorder}" />
    <SolidColorBrush x:Key="AlchemyBorderStrongBrush" Color="{StaticResource AlchemyBorderStrong}" />
    <SolidColorBrush x:Key="AlchemyAccentBrush" Color="{StaticResource AlchemyAccent}" />
    <SolidColorBrush x:Key="AlchemyFocusBrush" Color="{StaticResource AlchemyFocus}" />
    <SolidColorBrush x:Key="AlchemyTextBrush" Color="{StaticResource AlchemyText}" />
    <SolidColorBrush x:Key="AlchemyMutedTextBrush" Color="{StaticResource AlchemyMutedText}" />
    <SolidColorBrush x:Key="AlchemyHoverBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="AlchemyPressedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AlchemySelectedBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AlchemyAccentHoverBrush" Color="#FF75D1FF" />
    <SolidColorBrush x:Key="AlchemyAccentBorderBrush" Color="#994CC2FF" />
    <SolidColorBrush x:Key="AlchemyHeroBrush" Color="#FF232325" />
    <SolidColorBrush x:Key="AlchemySuccessBrush" Color="#FF54D68B" />
    <SolidColorBrush x:Key="AlchemyErrorBrush" Color="#FFFF7B86" />
    <SolidColorBrush x:Key="AlchemyBaseClipBrush" Color="#FF54436E" />
    <SolidColorBrush x:Key="AlchemyBaseEdgeBrush" Color="#FFC6ABEF" />
    <SolidColorBrush x:Key="AlchemyLayerClipBrush" Color="#FF36523E" />
    <SolidColorBrush x:Key="AlchemyLayerEdgeBrush" Color="#FFA2D2A5" />
  </Application.Resources>
</Application>
