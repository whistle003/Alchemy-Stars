<Window
    x:Class="AlchemyStars.Avalonia.MainWindow"
    x:Name="Root"
    x:DataType="local:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlchemyStars.Avalonia"
    xmlns:engine="using:AlchemyStars.Engine"
    Title="{Binding WindowTitle}"
    Icon="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.ico"
    Width="1460"
    Height="900"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    KeyDown="WindowKeyDown"
    AutomationProperties.Name="{Binding WindowTitle}">

  <Grid ColumnDefinitions="64,*" RowDefinitions="56,*,30">
    <!-- Beutl-style activity rail: compact tools beside a dock-like editing workspace. -->
    <Border Grid.RowSpan="2" Background="{DynamicResource AlchemySidebarBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="3,8">
        <Border Width="46" Height="46" Padding="5" CornerRadius="8" Background="{DynamicResource AlchemySurfaceRaisedBrush}" BorderBrush="{DynamicResource AlchemyBorderStrongBrush}" BorderThickness="1" ToolTip.Tip="{Binding Text.ProductName}">
          <Image Source="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.png" Stretch="Uniform" AutomationProperties.Name="Alchemy Stars" />
        </Border>

        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
          <Button Classes="activity" Classes.selected="{Binding IsAnimationsPage}" Click="AnimationsPageClick" ToolTip.Tip="{Binding Text.Animations}" AutomationProperties.Name="{Binding Text.Animations}">
            <StackPanel Spacing="3" HorizontalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 L17,17 L3,17 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7 M8,11 L13,14 L8,17 Z" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.Animations}" FontSize="10" TextAlignment="Center" MaxWidth="52" TextWrapping="Wrap" /></StackPanel>
          </Button>
          <Button Classes="activity" Classes.selected="{Binding IsModelPartsPage}" Click="PartsPageClick" ToolTip.Tip="{Binding Text.ModelParts}" AutomationProperties.Name="{Binding Text.ModelParts}">
            <StackPanel Spacing="3" HorizontalAlignment="Center"><Path Classes="icon-glyph muted" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.ModelParts}" FontSize="10" TextAlignment="Center" MaxWidth="52" TextWrapping="Wrap" /></StackPanel>
          </Button>
          <Border Height="1" Background="{DynamicResource AlchemyBorderBrush}" Margin="8,6" />
          <Button Classes="activity" Classes.selected="{Binding IsSettingsPage}" Click="SettingsPageClick" ToolTip.Tip="{Binding Text.Settings}" AutomationProperties.Name="{Binding Text.Settings}">
            <StackPanel Spacing="3" HorizontalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.Settings}" FontSize="10" TextAlignment="Center" MaxWidth="52" TextWrapping="Wrap" /></StackPanel>
          </Button>
          <Button Classes="activity" Classes.selected="{Binding IsAboutPage}" Click="AboutPageClick" ToolTip.Tip="{Binding Text.About}" AutomationProperties.Name="{Binding Text.About}">
            <StackPanel Spacing="3" HorizontalAlignment="Center"><Path Classes="icon-glyph muted" Data="M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 M10,9 L10,15 M10,6 L10,7" IsHitTestVisible="False" /><TextBlock Text="{Binding Text.About}" FontSize="10" TextAlignment="Center" MaxWidth="52" TextWrapping="Wrap" /></StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
          <Border Height="1" Background="{DynamicResource AlchemyBorderBrush}" Margin="8,0,8,4" />
          <Button Classes="activity" Click="LanguageClick" AutomationProperties.Name="{Binding LanguageButtonAccessibleName}" ToolTip.Tip="{Binding LanguageButtonAccessibleName}">
            <StackPanel Spacing="3" HorizontalAlignment="Center"><Path Classes="icon-glyph muted" Data="M3,4 L11,4 M7,2 L7,4 M5,4 C5,8 8,11 12,12 M10,4 C10,8 7,11 3,12 M13,8 L18,18 M11,18 L15.5,8 L20,18 M12.5,14 L18.5,14" IsHitTestVisible="False" /><TextBlock Text="{Binding LanguageButtonLabel}" FontSize="10" TextAlignment="Center" MaxWidth="52" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Context command bar. -->
    <Border Grid.Column="1" Background="{DynamicResource AlchemyCommandBarBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0" ColumnDefinitions="*,Auto">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Text.ProductName}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="›" Classes="muted" FontSize="17" Margin="10,0" />
          <TextBlock Grid.Column="2" Text="{Binding CurrentProjectLabel}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentProjectLabel}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="›" Classes="muted" FontSize="17" Margin="10,0" />
          <TextBlock Grid.Column="4" Text="{Binding CurrentPageTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="toolbar" Click="NewProjectClick" ToolTip.Tip="{Binding Text.NewProject}" AutomationProperties.Name="{Binding Text.NewProject}">
            <Path Classes="icon-glyph" Data="M4,2 L13,2 L17,6 L17,18 L4,18 Z M13,2 L13,6 L17,6 M10.5,9 L10.5,15 M7.5,12 L13.5,12" IsHitTestVisible="False" />
          </Button>
          <Button Classes="toolbar" Click="OpenProjectClick" ToolTip.Tip="{Binding Text.OpenProject}" AutomationProperties.Name="{Binding Text.OpenProject}">
            <Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" IsHitTestVisible="False" />
          </Button>
          <Button Classes="toolbar" Click="SaveProjectClick" ToolTip.Tip="{Binding Text.SaveProject}" AutomationProperties.Name="{Binding Text.SaveProject}">
            <Path Classes="icon-glyph" Data="M3,2 L15,2 L18,5 L18,18 L2,18 L2,2 Z M5,2 L5,8 L14,8 L14,2 M5,12 L15,12 L15,18 L5,18" IsHitTestVisible="False" />
          </Button>
          <Button Classes="toolbar" Click="SaveProjectAsClick" ToolTip.Tip="{Binding Text.SaveProjectAs}" AutomationProperties.Name="{Binding Text.SaveProjectAs}">
            <Path Classes="icon-glyph" Data="M3,2 L14,2 L17,5 L17,10 M5,2 L5,7 L13,7 L13,2 M3,11 L10,11 L10,18 L3,18 Z M12,16 L17,11 L19,13 L14,18 L11,19 Z" IsHitTestVisible="False" />
          </Button>
          <Border Width="1" Height="28" Background="{DynamicResource AlchemyBorderBrush}" Margin="6,0" />
          <Button Classes="primary" Click="ExportClick" MinWidth="124" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{Binding Text.Export}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon-glyph on-accent" Width="18" Height="18" Data="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,18 L17,18 L17,16" IsHitTestVisible="False" />
              <TextBlock Text="{Binding Text.Export}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Beutl-inspired animation editor: library, composition, tracks and inspector. -->
    <Grid Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsAnimationsPage}" ColumnDefinitions="210,1,*,1,320">
      <Border x:Name="AnimationDropZone" Classes="workspace-panel dropzone" DragDrop.AllowDrop="True" DragDrop.DragOver="DropZoneDragOver" DragDrop.Drop="AnimationDrop" AutomationProperties.Name="{Binding Text.AnimationWorkspace}">
        <Border.ContextMenu><ContextMenu><MenuItem Header="导入动画… / Import animations…" Click="AddAnimationClick" /></ContextMenu></Border.ContextMenu>
        <Grid RowDefinitions="44,Auto,*,Auto">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M3,5 L17,5 L17,17 L3,17 Z M3,9 L17,9 M7,2 L7,7 M13,2 L13,7"/><TextBlock Text="{Binding Text.AssetLibrary}" Classes="dock-title" /></StackPanel><Button Grid.Column="1" Classes="panel-command" Click="AddAnimationClick" ToolTip.Tip="{Binding Text.AddAnimation}" AutomationProperties.Name="{Binding Text.AddAnimation}"><Path Classes="icon-glyph" Width="16" Height="16" Data="M10,3 L10,17 M3,10 L17,10" /></Button></Grid></Border>
          <TextBlock Grid.Row="1" Text="{Binding Text.EmptyAnimationsHelp}" Classes="muted" FontSize="10" Margin="12,10,12,2" TextWrapping="Wrap" />
          <ListBox Grid.Row="2" Margin="7" ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Text.Animations}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="engine:WorkspaceAnimation"><Grid ColumnDefinitions="4,10,*" Margin="2,5"><Border Background="{DynamicResource AlchemyAccentBrush}" CornerRadius="2" /><StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Name}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="8"><Border Classes="count-badge" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Animations.Count}" /></Border><Button Grid.Column="1" Classes="icon danger subtle" Click="RemoveAnimationClick" ToolTip.Tip="{Binding Text.Remove}" IsEnabled="{Binding HasSelectedAnimation}" AutomationProperties.Name="{Binding Text.Remove}"><Path Classes="icon-glyph danger-glyph" Data="M4,6 L16,6 M8,3 L12,3 L14,6 M6,6 L7,18 L13,18 L14,6 M9,9 L9,15 M11,9 L11,15" /></Button></Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource AlchemyBorderBrush}" />

      <Grid Grid.Column="2" RowDefinitions="*,1,220" Background="{DynamicResource AlchemyCanvasBrush}">
        <Border Classes="composition-canvas" IsEnabled="{Binding HasSelectedAnimation}">
          <Grid RowDefinitions="44,*">
            <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M4,4 L16,4 L16,16 L4,16 Z M7,7 L13,7 L13,13 L7,13"/><TextBlock Text="{Binding Text.Composition}" Classes="dock-title" /></StackPanel><Button Grid.Column="1" Classes="panel-command" Click="GenerateSprintBatchClick" IsEnabled="{Binding HasSelectedAnimation}" ToolTip.Tip="{Binding Text.GenerateSprintBatch}" AutomationProperties.Name="{Binding Text.GenerateSprintBatch}"><Path Classes="icon-glyph" Width="16" Height="16" Data="M10,2 L11.5,7.5 L17,10 L11.5,12.5 L10,18 L8.5,12.5 L3,10 L8.5,7.5 Z" /></Button></Grid></Border>
            <Grid Grid.Row="1" Margin="18">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="620">
                <Border Width="64" Height="64" Padding="10" CornerRadius="16" Background="#12171E" BorderBrush="{DynamicResource AlchemyAccentBorderBrush}" BorderThickness="1"><Image Source="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.png" Stretch="Uniform" /></Border>
                <StackPanel Spacing="5"><TextBlock Text="{Binding SelectedAnimation.OutputName}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SelectedAnimation.Name}" Classes="muted" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" /></StackPanel>
                <Grid ColumnDefinitions="*,28,*" MaxWidth="560" HorizontalAlignment="Stretch">
                  <Border Classes="workflow-node"><StackPanel Spacing="4"><TextBlock Text="{Binding Text.ModelParts}" Classes="eyebrow" /><TextBlock Text="{Binding Parts.Count}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Text.ProjectAssets}" Classes="muted" FontSize="10" /></StackPanel></Border>
                  <Path Grid.Column="1" Classes="icon-glyph muted" Width="16" Height="16" VerticalAlignment="Center" Data="M4,10 L16,10 M12,6 L16,10 L12,14" />
                  <Border Grid.Column="2" Classes="workflow-node"><StackPanel Spacing="4"><TextBlock Text="{Binding Text.Layers}" Classes="eyebrow" /><TextBlock Text="{Binding SelectedAnimation.Layers.Count}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Text.TrackEditor}" Classes="muted" FontSize="10" /></StackPanel></Border>
                </Grid>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource AlchemyBorderBrush}" />

        <Border Grid.Row="2" x:Name="LayerDropZone" Classes="workspace-panel dropzone" DragDrop.AllowDrop="True" DragDrop.DragOver="DropZoneDragOver" DragDrop.Drop="LayerDrop" AutomationProperties.Name="{Binding Text.Layers}">
          <Border.ContextMenu><ContextMenu><MenuItem Header="导入动画层… / Import animation layers…" Click="AddLayerClick" /></ContextMenu></Border.ContextMenu>
          <Grid RowDefinitions="44,*">
            <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M6,3 L6,7 M11,8 L11,12 M15,13 L15,17"/><TextBlock Text="{Binding Text.TrackEditor}" Classes="dock-title" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Classes="panel-command" Click="AddLayerClick" ToolTip.Tip="{Binding Text.AddLayer}" AutomationProperties.Name="{Binding Text.AddLayer}"><Path Classes="icon-glyph" Width="16" Height="16" Data="M10,3 L10,17 M3,10 L17,10" /></Button><Button Classes="panel-command" Click="MoveLayerUpClick" ToolTip.Tip="{Binding Text.MoveUp}" AutomationProperties.Name="{Binding Text.MoveUp}" IsEnabled="{Binding HasSelectedLayer}"><Path Classes="icon-glyph" Width="16" Height="16" Data="M4,12 L10,6 L16,12 M10,6 L10,17" /></Button><Button Classes="panel-command" Click="MoveLayerDownClick" ToolTip.Tip="{Binding Text.MoveDown}" AutomationProperties.Name="{Binding Text.MoveDown}" IsEnabled="{Binding HasSelectedLayer}"><Path Classes="icon-glyph" Width="16" Height="16" Data="M4,8 L10,14 L16,8 M10,3 L10,14" /></Button><Button Classes="panel-command danger" Click="RemoveLayerClick" ToolTip.Tip="{Binding Text.Remove}" AutomationProperties.Name="{Binding Text.Remove}" IsEnabled="{Binding HasSelectedLayer}"><Path Classes="icon-glyph danger-glyph" Width="16" Height="16" Data="M4,6 L16,6 M8,3 L12,3 L14,6 M6,6 L7,18 L13,18 L14,6" /></Button></StackPanel></Grid></Border>
            <ListBox Grid.Row="1" Margin="6" ItemsSource="{Binding SelectedAnimation.Layers}" SelectedItem="{Binding SelectedLayer}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Text.Layers}">
              <ListBox.ItemTemplate><DataTemplate x:DataType="engine:WorkspaceLayer"><Grid ColumnDefinitions="24,120,*,48" Margin="4,2"><Path Classes="icon-glyph muted" Width="15" Height="15" VerticalAlignment="Center" Data="M4,10 L16,10 M4,6 L16,6 M4,14 L16,14"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Name}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel><Border Grid.Column="2" Height="24" Margin="8,0" VerticalAlignment="Center" CornerRadius="3" Background="#6F4CC2FF" BorderBrush="{DynamicResource AlchemyAccentBrush}" BorderThickness="1"><TextBlock Text="{Binding DisplayName}" Margin="8,0" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" /></Border><Border Grid.Column="3" Classes="count-badge" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Offset}" /></Border></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="3" Background="{DynamicResource AlchemyBorderBrush}" />

      <Border Grid.Column="4" Classes="workspace-panel" IsEnabled="{Binding HasSelectedAnimation}">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><Grid RowDefinitions="*,2"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17"/><TextBlock Text="{Binding Text.Inspector}" Classes="dock-title" /></StackPanel><Border Grid.Row="1" Width="92" Height="2" HorizontalAlignment="Left" Background="{DynamicResource AlchemyAccentBrush}" /></Grid></Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="14" Spacing="16">
            <StackPanel><TextBlock Text="{Binding Text.AnimationFile}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.Name}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="AnimationPathDrop" AutomationProperties.Name="{Binding Text.AnimationFile}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseAnimationClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel>
            <Border Classes="inspector-section" IsEnabled="{Binding HasSelectedLayer}"><StackPanel Spacing="12"><TextBlock Text="{Binding Text.SelectedLayer}" Classes="card-title" /><StackPanel><TextBlock Text="{Binding Text.LayerFile}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedLayer.Name}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="LayerPathDrop" AutomationProperties.Name="{Binding Text.LayerFile}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseLayerClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel><Grid ColumnDefinitions="*,12,84"><StackPanel><TextBlock Text="{Binding Text.LayerMode}" Classes="field-label" /><ComboBox ItemsSource="{Binding Text.LayerTypes}" SelectedIndex="{Binding SelectedLayer.TypeIndex}" AutomationProperties.Name="{Binding Text.LayerMode}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.Offset}" Classes="field-label" /><TextBox Text="{Binding SelectedLayer.Offset}" AutomationProperties.Name="{Binding Text.Offset}" /></StackPanel></Grid></StackPanel></Border>
            <Border Classes="inspector-section"><StackPanel Spacing="12"><TextBlock Text="{Binding Text.HandPoses}" Classes="card-title" /><StackPanel><TextBlock Text="{Binding Text.LeftPose}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.LeftHandPoseFile}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="LeftPosePathDrop" AutomationProperties.Name="{Binding Text.LeftPose}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseLeftPoseClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel><StackPanel><TextBlock Text="{Binding Text.RightPose}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.RightHandPoseFile}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="RightPosePathDrop" AutomationProperties.Name="{Binding Text.RightPose}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseRightPoseClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel></StackPanel></Border>
            <Border Classes="inspector-section"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.IkControls}" Classes="card-title" /><CheckBox IsChecked="{Binding SelectedAnimation.EnableLeftHandIK}" Content="{Binding Text.EnableLeftIk}" AutomationProperties.Name="{Binding Text.EnableLeftIk}" /><TextBox Text="{Binding SelectedAnimation.LeftIKTargetBoneName}" PlaceholderText="{Binding Text.LeftTargetOverride}" AutomationProperties.Name="{Binding Text.LeftTargetOverride}" /><CheckBox IsChecked="{Binding SelectedAnimation.EnableRightHandIK}" Content="{Binding Text.EnableRightIk}" AutomationProperties.Name="{Binding Text.EnableRightIk}" /><TextBox Text="{Binding SelectedAnimation.RightIKTargetBoneName}" PlaceholderText="{Binding Text.RightTargetOverride}" AutomationProperties.Name="{Binding Text.RightTargetOverride}" /></StackPanel></Border>
            <Border Classes="inspector-section"><StackPanel Spacing="12"><TextBlock Text="{Binding Text.ExportTarget}" Classes="card-title" /><StackPanel><TextBlock Text="{Binding Text.OutputName}" Classes="field-label" /><TextBox Text="{Binding SelectedAnimation.OutputName}" AutomationProperties.Name="{Binding Text.OutputName}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.Framerate}" Classes="field-label" /><TextBox Text="{Binding SelectedAnimation.OutputFramerate}" AutomationProperties.Name="{Binding Text.Framerate}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.OutputFolder}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedAnimation.OutputFolder}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="OutputPathDrop" AutomationProperties.Name="{Binding Text.OutputFolder}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowseOutputFolderClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Model-parts workspace uses the same library/canvas/inspector grammar. -->
    <Grid Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsModelPartsPage}" ColumnDefinitions="210,1,*,1,320">
      <Border x:Name="PartDropZone" Classes="workspace-panel dropzone" DragDrop.AllowDrop="True" DragDrop.DragOver="DropZoneDragOver" DragDrop.Drop="PartDrop" AutomationProperties.Name="{Binding Text.ModelParts}">
        <Border.ContextMenu><ContextMenu><MenuItem Header="导入模型部件… / Import model parts…" Click="AddPartClick" /></ContextMenu></Border.ContextMenu>
        <Grid RowDefinitions="44,Auto,*,Auto">
          <Border Classes="dock-header"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14"/><TextBlock Text="{Binding Text.AssetLibrary}" Classes="dock-title" /></StackPanel><Button Grid.Column="1" Classes="panel-command" Click="AddPartClick" ToolTip.Tip="{Binding Text.AddPart}" AutomationProperties.Name="{Binding Text.AddPart}"><Path Classes="icon-glyph" Width="16" Height="16" Data="M10,3 L10,17 M3,10 L17,10" /></Button></Grid></Border>
          <TextBlock Grid.Row="1" Text="{Binding Text.EmptyPartsHelp}" Classes="muted" FontSize="10" Margin="12,10,12,2" TextWrapping="Wrap" />
          <ListBox Grid.Row="2" Margin="7" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Text.ModelParts}"><ListBox.ItemTemplate><DataTemplate x:DataType="engine:WorkspacePart"><Grid ColumnDefinitions="4,10,*" Margin="2,5"><Border Background="{DynamicResource AlchemyAccentBrush}" CornerRadius="2" /><StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FilePath}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Grid Grid.Row="3" ColumnDefinitions="*,44,44,44" Margin="8"><Border Classes="count-badge" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Parts.Count}" /></Border><Button Grid.Column="1" Classes="icon secondary" Click="MovePartUpClick" ToolTip.Tip="{Binding Text.MoveUp}" AutomationProperties.Name="{Binding Text.MoveUp}"><Path Classes="icon-glyph" Data="M4,12 L10,6 L16,12 M10,6 L10,17" /></Button><Button Grid.Column="2" Classes="icon secondary" Click="MovePartDownClick" ToolTip.Tip="{Binding Text.MoveDown}" AutomationProperties.Name="{Binding Text.MoveDown}"><Path Classes="icon-glyph" Data="M4,8 L10,14 L16,8 M10,3 L10,14" /></Button><Button Grid.Column="3" Classes="icon danger subtle" Click="RemovePartClick" ToolTip.Tip="{Binding Text.Remove}" IsEnabled="{Binding HasSelectedPart}" AutomationProperties.Name="{Binding Text.Remove}"><Path Classes="icon-glyph danger-glyph" Data="M4,6 L16,6 M8,3 L12,3 L14,6 M6,6 L7,18 L13,18 L14,6" /></Button></Grid>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource AlchemyBorderBrush}" />
      <Border Grid.Column="2" Classes="composition-canvas" IsEnabled="{Binding HasSelectedPart}">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M4,4 L16,4 L16,16 L4,16 Z M7,7 L13,7 L13,13 L7,13"/><TextBlock Text="{Binding Text.Composition}" Classes="dock-title" /></StackPanel></Border>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="30" MaxWidth="620">
            <Path Classes="icon-glyph accent" Width="72" Height="72" StrokeThickness="1.2" Data="M10,2 L18,6 L10,10 L2,6 Z M2,10 L10,14 L18,10 M2,14 L10,18 L18,14" />
            <StackPanel Spacing="5"><TextBlock Text="{Binding SelectedPart.DisplayName}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{Binding SelectedPart.FilePath}" Classes="muted" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" /></StackPanel>
            <Grid ColumnDefinitions="*,28,*" MaxWidth="540" HorizontalAlignment="Stretch"><Border Classes="workflow-node"><StackPanel Spacing="4"><TextBlock Text="{Binding Text.ModelParts}" Classes="eyebrow" /><TextBlock Text="{Binding Parts.Count}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Text.HierarchyOrder}" Classes="muted" FontSize="10" /></StackPanel></Border><Path Grid.Column="1" Classes="icon-glyph muted" Width="16" Height="16" VerticalAlignment="Center" Data="M4,10 L16,10 M12,6 L16,10 L12,14" /><Border Grid.Column="2" Classes="workflow-node"><StackPanel Spacing="4"><TextBlock Text="{Binding Text.ParentBone}" Classes="eyebrow" /><TextBlock Text="{Binding SelectedPart.ParentBoneTag}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Text.AttachmentTarget}" Classes="muted" FontSize="10" /></StackPanel></Border></Grid>
            <TextBlock Text="{Binding Text.ModelWorkspaceHelp}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="3" Background="{DynamicResource AlchemyBorderBrush}" />
      <Border Grid.Column="4" Classes="workspace-panel" IsEnabled="{Binding HasSelectedPart}">
        <Grid RowDefinitions="44,*">
          <Border Classes="dock-header"><Grid RowDefinitions="*,2"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Path Classes="icon-glyph muted" Width="17" Height="17" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17"/><TextBlock Text="{Binding Text.Inspector}" Classes="dock-title" /></StackPanel><Border Grid.Row="1" Width="92" Height="2" HorizontalAlignment="Left" Background="{DynamicResource AlchemyAccentBrush}" /></Grid></Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" Spacing="18">
              <StackPanel><TextBlock Text="{Binding Text.ModelFile}" Classes="field-label" /><Grid ColumnDefinitions="*,8,44"><TextBox Text="{Binding SelectedPart.FilePath}" DragDrop.AllowDrop="True" DragDrop.DragOver="PathDragOver" DragDrop.Drop="PartPathDrop" AutomationProperties.Name="{Binding Text.ModelFile}" /><Button Grid.Column="2" Classes="icon secondary" Click="BrowsePartClick" ToolTip.Tip="{Binding Text.Browse}" AutomationProperties.Name="{Binding Text.Browse}"><Path Classes="icon-glyph" Data="M2,6 L7.5,6 L9.5,8 L18,8 L16,17 L2,17 Z M2,6 L2,4 L8,4 L10,6" /></Button></Grid></StackPanel>
              <Border Classes="inspector-section"><StackPanel Spacing="12"><TextBlock Text="{Binding Text.PartDetails}" Classes="card-title" /><StackPanel><TextBlock Text="{Binding Text.PartType}" Classes="field-label" /><ComboBox ItemsSource="{Binding Text.PartTypes}" SelectedIndex="{Binding SelectedPart.TypeIndex}" AutomationProperties.Name="{Binding Text.PartType}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.ParentBone}" Classes="field-label" /><TextBox Text="{Binding SelectedPart.ParentBoneTag}" AutomationProperties.Name="{Binding Text.ParentBone}" /></StackPanel></StackPanel></Border>
              <Border Classes="inspector-section"><Grid ColumnDefinitions="Auto,12,*"><Path Classes="icon-glyph accent" Data="M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 M10,9 L10,15 M10,6 L10,7" /><TextBlock Grid.Column="2" Text="{Binding Text.PartOrderHelp}" Classes="muted" TextWrapping="Wrap" /></Grid></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings workspace -->
    <ScrollViewer Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsSettingsPage}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,12,14,28" Spacing="14" MaxWidth="1080">
        <StackPanel Spacing="3"><TextBlock Text="{Binding Text.OutputSettings}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding Text.OutputSettingsHelp}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
        <Grid ColumnDefinitions="*,16,*">
          <Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="Auto,12,*"><Border Classes="feature-icon"><Path Classes="icon-glyph accent" Data="M10,2 L10,13 M6,9 L10,13 L14,9 M3,16 L3,18 L17,18 L17,16" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.DefaultOutputFormat}" Classes="card-title" /><TextBlock Text="{Binding Text.FormatHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid><ComboBox ItemsSource="{Binding OutputFormats}" SelectedIndex="{Binding OutputFormatIndex}" AutomationProperties.Name="{Binding Text.DefaultOutputFormat}" /><CheckBox IsChecked="{Binding Workspace.CastAnimationOnly}" Content="{Binding Text.AnimationOnlyCast}" IsEnabled="{Binding IsCastOutput}" AutomationProperties.Name="{Binding Text.AnimationOnlyCast}" /><TextBlock Text="{Binding Text.AnimationOnlyHelp}" Classes="muted" TextWrapping="Wrap" /><CheckBox IsChecked="{Binding Workspace.BakeRelevantBonesOnly}" Content="{Binding Text.SelectiveBake}" AutomationProperties.Name="{Binding Text.SelectiveBake}" /><TextBlock Text="{Binding Text.SelectiveBakeHelp}" Classes="muted" TextWrapping="Wrap" /><CheckBox IsChecked="{Binding Workspace.MatchOldCallOfDuty}" Content="{Binding Text.OldCod}" AutomationProperties.Name="{Binding Text.OldCod}" /></StackPanel></Border>
          <Border Grid.Column="2" Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="Auto,12,*"><Border Classes="feature-icon"><Path Classes="icon-glyph accent" Data="M3,5 L17,5 M3,10 L17,10 M3,15 L17,15 M7,3 L7,7 M13,8 L13,12 M8,13 L8,17" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.NamingAndLanguage}" Classes="card-title" /><TextBlock Text="{Binding Text.NamingHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid><StackPanel><TextBlock Text="{Binding Text.Prefix}" Classes="field-label" /><TextBox Text="{Binding Workspace.OutputPrefix}" AutomationProperties.Name="{Binding Text.Prefix}" /></StackPanel><StackPanel><TextBlock Text="{Binding Text.Suffix}" Classes="field-label" /><TextBox Text="{Binding Workspace.OutputSuffix}" AutomationProperties.Name="{Binding Text.Suffix}" /></StackPanel><TextBlock Text="{Binding Text.Language}" Classes="field-label" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="LanguageClick" Content="{Binding LanguageButtonLabel}" AutomationProperties.Name="{Binding LanguageButtonAccessibleName}" /><Button Classes="secondary" Click="SystemLanguageClick" Content="{Binding Text.FollowSystem}" AutomationProperties.Name="{Binding Text.FollowSystem}" /></StackPanel></StackPanel></Border>
        </Grid>
        <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="Auto,12,*"><Border Classes="feature-icon"><Path Classes="icon-glyph accent" Data="M3,16 L7,12 L10,15 L17,8 M3,5 L6,8 L10,4 L17,11 M3,16 L3,5 M17,8 L17,11" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Text.IkDefaults}" Classes="card-title" /><TextBlock Text="{Binding Text.IkHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Grid><Grid ColumnDefinitions="*,24,*"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.LeftIk}" Classes="eyebrow" /><TextBlock Text="{Binding Text.StartBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKStartBoneName}" AutomationProperties.Name="{Binding Text.LeftStartBone}" /><TextBlock Text="{Binding Text.MiddleBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKMidBoneName}" AutomationProperties.Name="{Binding Text.LeftMiddleBone}" /><TextBlock Text="{Binding Text.EndBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKEndBoneName}" AutomationProperties.Name="{Binding Text.LeftEndBone}" /><TextBlock Text="{Binding Text.TargetBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.LeftIKTargetBoneName}" AutomationProperties.Name="{Binding Text.LeftTargetBone}" /></StackPanel><StackPanel Grid.Column="2" Spacing="10"><TextBlock Text="{Binding Text.RightIk}" Classes="eyebrow" /><TextBlock Text="{Binding Text.StartBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKStartBoneName}" AutomationProperties.Name="{Binding Text.RightStartBone}" /><TextBlock Text="{Binding Text.MiddleBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKMidBoneName}" AutomationProperties.Name="{Binding Text.RightMiddleBone}" /><TextBlock Text="{Binding Text.EndBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKEndBoneName}" AutomationProperties.Name="{Binding Text.RightEndBone}" /><TextBlock Text="{Binding Text.TargetBone}" Classes="field-label" /><TextBox Text="{Binding Workspace.RightIKTargetBoneName}" AutomationProperties.Name="{Binding Text.RightTargetBone}" /></StackPanel></Grid></StackPanel></Border>
        <Button Classes="primary" Click="SaveDefaultsClick" Content="{Binding Text.SaveDefaults}" HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text.SaveDefaults}" />
      </StackPanel>
    </ScrollViewer>

    <!-- About workspace -->
    <ScrollViewer Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsAboutPage}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,26,30,38" Spacing="18" MaxWidth="900" HorizontalAlignment="Center">
        <Grid ColumnDefinitions="116,26,*"><Border Width="116" Height="116" Padding="12" Background="{DynamicResource AlchemySurfaceBrush}" BorderBrush="{DynamicResource AlchemyBorderStrongBrush}" BorderThickness="1" CornerRadius="26"><Image Source="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.png" Stretch="Uniform" AutomationProperties.Name="Alchemy Stars application icon" /></Border><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7"><TextBlock Text="{Binding Text.AboutTitle}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Text.AboutSubtitle}" Classes="muted" FontSize="15" TextWrapping="Wrap" /><Border Classes="preview-badge" HorizontalAlignment="Left"><TextBlock Text="1.3.0-preview.6 · .NET 11 · Native AOT" Classes="eyebrow" /></Border></StackPanel></Grid>
        <Border Classes="hero-card"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.AboutOverview}" TextWrapping="Wrap" FontSize="16" /><TextBlock Text="{Binding Text.Capabilities}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
        <Grid ColumnDefinitions="*,16,*"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.Build}" Classes="card-title" /><TextBlock Text="{Binding RuntimeDescription}" Classes="muted" /><TextBlock Text="{Binding Text.License}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border><Border Grid.Column="2" Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding Text.UpstreamTitle}" Classes="card-title" /><TextBlock Text="{Binding Text.UpstreamHelp}" Classes="muted" TextWrapping="Wrap" /><Button Classes="secondary" Click="OpenUpstreamClick" Content="{Binding Text.Upstream}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text.Upstream}" /></StackPanel></Border></Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.ColumnSpan="2" Grid.Row="2" Background="{DynamicResource AlchemyCommandBarBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0" ColumnDefinitions="Auto,8,*,Auto" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AlchemySuccessBrush}" /><TextBlock Grid.Column="2" Text="{Binding FooterStatus}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Version}" Classes="muted" FontSize="11" /></Grid>
    </Border>

    <!-- Window-owned overlays keep progress and feedback centered and keyboard-contained. -->
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsBusy}" Background="#B5000000" ZIndex="20" AutomationProperties.Name="{Binding BusyMessage}" AutomationProperties.LiveSetting="Polite">
      <Border Classes="dialog-card" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16"><ProgressBar IsIndeterminate="True" Height="5" /><TextBlock Text="{Binding BusyMessage}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" /></StackPanel></Border>
    </Grid>
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsDialogOpen}" Background="#B5000000" ZIndex="30" KeyDown="DialogKeyDown">
      <Border Classes="dialog-card" Width="560" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
        <Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="42,14,*" Margin="0,0,0,15"><Border Width="42" Height="42" CornerRadius="8" Background="#1A4CC2FF"><Path Classes="icon-glyph accent" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 M10,6 L10,11 M10,14 L10,15" IsHitTestVisible="False" /></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Text.Notification}" Classes="eyebrow" /><TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Grid><ScrollViewer Grid.Row="1" MaxHeight="330"><TextBlock Text="{Binding DialogMessage}" Classes="muted" TextWrapping="Wrap" /></ScrollViewer><Button x:Name="DialogCloseButton" Grid.Row="2" Classes="primary" Click="CloseDialogClick" Content="{Binding Text.Close}" HorizontalAlignment="Right" Margin="0,18,0,0" AutomationProperties.Name="{Binding Text.Close}" /></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
