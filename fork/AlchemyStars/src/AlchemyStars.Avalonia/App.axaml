<Application
    x:Class="AlchemyStars.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Noto Sans CJK SC, sans-serif" />
      <Setter Property="Background" Value="{DynamicResource AlchemyBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlchemyHoverBrush}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="Foreground" Value="#FF101014" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource AlchemySelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AlchemyTextBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AlchemySurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlchemyBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyAccentBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AlchemyMutedTextBrush}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <Color x:Key="AlchemyBackground">#FF101014</Color>
    <Color x:Key="AlchemySidebar">#FF17171F</Color>
    <Color x:Key="AlchemySurface">#FF20202B</Color>
    <Color x:Key="AlchemySurfaceRaised">#FF292937</Color>
    <Color x:Key="AlchemyBorder">#FF3B3B4C</Color>
    <Color x:Key="AlchemyAccent">#FFF97316</Color>
    <Color x:Key="AlchemyFocus">#FF60A5FA</Color>
    <Color x:Key="AlchemyText">#FFF7F7FA</Color>
    <Color x:Key="AlchemyMutedText">#FFB8B8C7</Color>
    <SolidColorBrush x:Key="AlchemyBackgroundBrush" Color="{StaticResource AlchemyBackground}" />
    <SolidColorBrush x:Key="AlchemySidebarBrush" Color="{StaticResource AlchemySidebar}" />
    <SolidColorBrush x:Key="AlchemySurfaceBrush" Color="{StaticResource AlchemySurface}" />
    <SolidColorBrush x:Key="AlchemySurfaceRaisedBrush" Color="{StaticResource AlchemySurfaceRaised}" />
    <SolidColorBrush x:Key="AlchemyBorderBrush" Color="{StaticResource AlchemyBorder}" />
    <SolidColorBrush x:Key="AlchemyAccentBrush" Color="{StaticResource AlchemyAccent}" />
    <SolidColorBrush x:Key="AlchemyFocusBrush" Color="{StaticResource AlchemyFocus}" />
    <SolidColorBrush x:Key="AlchemyTextBrush" Color="{StaticResource AlchemyText}" />
    <SolidColorBrush x:Key="AlchemyMutedTextBrush" Color="{StaticResource AlchemyMutedText}" />
    <SolidColorBrush x:Key="AlchemyHoverBrush" Color="#FF343446" />
    <SolidColorBrush x:Key="AlchemySelectedBrush" Color="#FF303047" />
    <SolidColorBrush x:Key="AlchemySuccessBrush" Color="#FF34D399" />
  </Application.Resources>
</Application>
