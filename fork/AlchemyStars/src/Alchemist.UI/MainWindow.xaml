<Window x:Class="Alchemist.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Alchemist.UI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        Title="{Binding Title}" KeyDown="WindowKeyDown" AutomationProperties.AutomationId="MainWindow"
        Height="768" Width="1366" MinHeight="520" MinWidth="900">
    <Window.Resources>
        <Style x:Key="PathBrowseButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ToolTip" Value="{DynamicResource Browse}"/>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost DialogClosing="DialogHostDialogClosing"
                               OpenDialogCommandDataContextSource="DialogHostInstance"
                               DialogTheme="Inherit" Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ToolBarTray IsLocked="True" Grid.Column="0">
                    <ToolBar ClipToBounds="False" Style="{StaticResource MaterialDesignToolBar}">
                    <Button Content="{materialDesign:PackIcon Kind=PackageDown}" ToolTip="{DynamicResource TipLoadProject}" Command="{Binding ImportProjectCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=PackageUp}" ToolTip="{DynamicResource TipSaveProject}" Command="{Binding SaveProjectCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=Package}" ToolTip="{DynamicResource TipSaveProjectAs}" Command="{Binding SaveProjectAsCommand}"/>
                    <Separator/>
                    <Button Content="{materialDesign:PackIcon Kind=FileUpload}" ToolTip="{DynamicResource TipAddAnimations}" Command="{Binding AddAnimationsCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=FileDownload}" ToolTip="{DynamicResource TipExportAnimations}" Command="{Binding SaveAnimationsCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=FileRemove}" ToolTip="{DynamicResource TipRemoveAnimations}" Command="{Binding RemoveAnimationsCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=Folder}" ToolTip="{DynamicResource TipOutputFolder}" Command="{Binding SetOutputFolderCommand}"/>
                    <Separator/>
                    <Button Content="{materialDesign:PackIcon Kind=ArrowLeftBold}" ToolTip="{DynamicResource TipEnableLeftIK}" Command="{Binding ToggleLeftHandIKCommand}" CommandParameter="Enable"/>
                    <Button Content="{materialDesign:PackIcon Kind=ArrowRightBold}" ToolTip="{DynamicResource TipEnableRightIK}" Command="{Binding ToggleRightHandIKCommand}" CommandParameter="Enable"/>
                    <Button Content="{materialDesign:PackIcon Kind=ArrowLeftBoldOutline}" ToolTip="{DynamicResource TipDisableLeftIK}" Command="{Binding ToggleLeftHandIKCommand}" CommandParameter="Disable"/>
                    <Button Content="{materialDesign:PackIcon Kind=ArrowRightBoldOutline}" ToolTip="{DynamicResource TipDisableRightIK}" Command="{Binding ToggleRightHandIKCommand}" CommandParameter="Disable"/>
                    <Button Content="{materialDesign:PackIcon Kind=StepBackward}" ToolTip="{DynamicResource TipAddPrefix}"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" materialDesign:DialogHost.DialogClosingAttached="DialogHostDialogClosing">
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="320">
                                <TextBlock Text="{DynamicResource AddPrefixPrompt}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBox x:Name="PrefixBox" Margin="0,12,0,0"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Accept}" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="AcceptPrefix"/>
                                    <Button Margin="8,0,0,0" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Cancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                                </StackPanel>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="{materialDesign:PackIcon Kind=StepForward}" ToolTip="{DynamicResource TipAddSuffix}"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" materialDesign:DialogHost.DialogClosingAttached="DialogHostDialogClosing">
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="320">
                                <TextBlock Text="{DynamicResource AddSuffixPrompt}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBox x:Name="SuffixBox" Margin="0,12,0,0"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Accept}" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="AcceptSuffix"/>
                                    <Button Margin="8,0,0,0" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Cancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                                </StackPanel>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="{materialDesign:PackIcon Kind=HandBackLeft}" ToolTip="{DynamicResource TipSetLeftPose}" Command="{Binding SetPoseFileCommand}" CommandParameter="Left"/>
                    <Button Content="{materialDesign:PackIcon Kind=HandBackRight}" ToolTip="{DynamicResource TipSetRightPose}" Command="{Binding SetPoseFileCommand}" CommandParameter="Right"/>
                    <Separator/>
                    <Button Content="{materialDesign:PackIcon Kind=FileUploadOutline}" ToolTip="{DynamicResource TipAddLayers}" Command="{Binding AddLayerCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=FileRemoveOutline}" ToolTip="{DynamicResource TipRemoveLayers}" Command="{Binding RemoveLayerCommand}"/>
                    <Separator/>
                    <Button Content="{materialDesign:PackIcon Kind=Bone}" ToolTip="{DynamicResource TipAddParts}" Command="{Binding AddPartsCommand}"/>
                    <Button Content="{materialDesign:PackIcon Kind=BoneOff}" ToolTip="{DynamicResource TipRemoveParts}" Command="{Binding RemovePartsCommand}"/>
                    <Separator/>
                    <Button Content="{materialDesign:PackIcon Kind=Cog}" ToolTip="{DynamicResource TipSettings}" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="360">
                                <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultLeftIKStart}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding LeftIKStartBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultLeftIKMiddle}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding LeftIKMidBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultLeftIKEnd}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding LeftIKEndBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultLeftIKTarget}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding LeftIKTargetBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultRightIKStart}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding RightIKStartBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultRightIKMiddle}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding RightIKMidBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultRightIKEnd}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding RightIKEndBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource DefaultRightIKTarget}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding RightIKTargetBoneName}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource OutputPrefix}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding OutputPrefix}"/>
                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource OutputSuffix}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding OutputSuffix}"/>
                                <CheckBox Content="{DynamicResource MatchOldCod}" IsChecked="{Binding MatchOldCallOfDuty}" Margin="0,12,0,0"/>
                                <ComboBox Margin="0,8,0,0" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}"/>
                                <Button Margin="0,12,0,0" HorizontalAlignment="Right" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="{materialDesign:PackIcon Kind=Script}" ToolTip="{DynamicResource TipExperimental}" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" materialDesign:DialogHost.DialogClosing="DialogHostDialogClosing">
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="280">
                                <TextBlock Text="{DynamicResource ScriptsTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ListBox x:Name="ScriptsListBox" Background="#30000000" SelectionMode="Multiple" ItemsSource="{Binding Scripts}" Height="192"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Run}" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Run"/>
                                    <Button Margin="8,0,0,0" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                                </StackPanel>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    </ToolBar>
                </ToolBarTray>
                <Border Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" Padding="4,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LanguageButton" ToolTip="{DynamicResource TipLanguage}" AutomationProperties.Name="{DynamicResource TipLanguage}" Click="ToggleLanguageClick" MinWidth="58" Height="44" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Translate" Width="20" Height="20"/><TextBlock Text="{DynamicResource LanguageButton}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="AboutButton" Content="{materialDesign:PackIcon Kind=InformationOutline}" ToolTip="{DynamicResource TipAbout}" AutomationProperties.Name="{DynamicResource TipAbout}" Click="OpenAboutClick" Width="44" Height="44" Style="{StaticResource MaterialDesignFlatButton}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryDark" Style="{StaticResource MaterialDesignFilledTabControl}">
                <TabItem Header="{DynamicResource AnimationsTab}" AutomationProperties.AutomationId="AnimationsTab">
                    <ListView x:Name="MainAnimationList" AutomationProperties.AutomationId="AnimationList" Visibility="{Binding IsVisible}" ItemsSource="{Binding Animations}" Background="#20000000" AllowDrop="True" Drop="ListViewDrop" SelectionChanged="ListViewSelectionChanged" PreviewMouseRightButtonUp="ImportSurfacePreviewMouseRightButtonUp" PreviewKeyDown="ImportSurfacePreviewKeyDown" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource ContextImportAnimations}" AutomationProperties.Name="{DynamicResource ContextImportAnimations}" AutomationProperties.AutomationId="ImportAnimationsContextMenuItem" Command="{Binding DataContext.AddAnimationsCommand}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="FileUploadOutline" Width="20" Height="20"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignGridViewItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource FileColumn}" Width="{Binding FileColumnWith}">
                                    <GridViewColumn.CellTemplate><DataTemplate><StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" IsReadOnly="True" materialDesign:HintAssist.Hint="{DynamicResource AnimationPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Name}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Click="BrowseAnimationClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" IsReadOnly="True" materialDesign:HintAssist.Hint="{DynamicResource LeftPosePath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding LeftHandPoseFile}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Left" Click="BrowsePoseClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button><Button Grid.Column="2" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Left" Click="ClearPoseClick" ToolTip="{DynamicResource TipDelete}"><materialDesign:PackIcon Kind="Close" Width="20" Height="20"/></Button></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" IsReadOnly="True" materialDesign:HintAssist.Hint="{DynamicResource RightPosePath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding RightHandPoseFile}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Right" Click="BrowsePoseClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button><Button Grid.Column="2" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Right" Click="ClearPoseClick" ToolTip="{DynamicResource TipDelete}"><materialDesign:PackIcon Kind="Close" Width="20" Height="20"/></Button></Grid>
                                    </StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource IKSettingsColumn}" Width="{Binding IKSettingsColumnWith}">
                                    <GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource LeftIKTargetOverride}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding LeftIKTargetBoneName}"/><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource RightIKTargetOverride}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding RightIKTargetBoneName}"/><CheckBox Margin="0,12,0,0" Content="{DynamicResource EnableLeftHand}" IsChecked="{Binding EnableLeftHandIK}"/><CheckBox Margin="0,8,0,0" Content="{DynamicResource EnableRightHand}" IsChecked="{Binding EnableRightHandIK}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource LayersColumn}" Width="{Binding LayersColumnWith, FallbackValue=600}">
                                    <GridViewColumn.CellTemplate><DataTemplate><ListBox Height="168" ItemsSource="{Binding Layers}" Background="#20000000" SelectionMode="Extended" SelectionChanged="ListBoxSelectionChanged" AutomationProperties.AutomationId="LayerList" Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext}">
                                        <ListBox.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource ContextImportLayers}" AutomationProperties.Name="{DynamicResource ContextImportLayers}" AutomationProperties.AutomationId="ImportLayersContextMenuItem" Command="{Binding Tag.AddLayersForAnimationCommand}" CommandParameter="{Binding DataContext}">
                                                    <MenuItem.Icon><materialDesign:PackIcon Kind="FileUploadOutline" Width="20" Height="20"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{Binding ColorBrush}"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="112"/><ColumnDefinition Width="66"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding Name}" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="{DynamicResource LayerPath}"/><Button Grid.Column="1" Style="{StaticResource PathBrowseButton}" Click="BrowseLayerClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button><ComboBox Grid.Column="2" Margin="4,0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.LayerTypeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Type, Mode=TwoWay}"/><TextBox Grid.Column="3" Margin="4,0" materialDesign:HintAssist.Hint="{DynamicResource Offset}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="4" Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowUpBold}" ToolTip="{DynamicResource TipMoveUp}" Command="{Binding MoveUpCommand}"/><Button Grid.Column="5" Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowDownBold}" ToolTip="{DynamicResource TipMoveDown}" Command="{Binding MoveDownCommand}"/><Button Grid.Column="6" Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=Delete}" ToolTip="{DynamicResource TipDelete}" Command="{Binding DeleteCommand}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource OutputColumn}" Width="{Binding OutputColumnWith}">
                                    <GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource OutputName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" IsReadOnly="True" materialDesign:HintAssist.Hint="{DynamicResource OutputFolder}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding OutputFolder}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Click="BrowseOutputFolderClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button></Grid><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource OutputFramerate}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding OutputFramerate, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="{DynamicResource ExperimentalFeatures}" IsChecked="{Binding UseExperimentalFeatures}" Margin="0,12,0,0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem Header="{DynamicResource PartsTab}" AutomationProperties.AutomationId="PartsTab">
                    <ListView x:Name="MainModelList" AutomationProperties.AutomationId="ModelPartsList" Visibility="{Binding IsVisible}" ItemsSource="{Binding Parts}" Background="#20000000" SelectionChanged="ListViewSelectionChanged" AllowDrop="True" Drop="ModelListDrop" PreviewMouseRightButtonUp="ImportSurfacePreviewMouseRightButtonUp" PreviewKeyDown="ImportSurfacePreviewKeyDown" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource ContextImportParts}" AutomationProperties.Name="{DynamicResource ContextImportParts}" AutomationProperties.AutomationId="ImportPartsContextMenuItem" Command="{Binding DataContext.AddPartsCommand}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="FileUploadOutline" Width="20" Height="20"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignGridViewItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                        <ListView.View><GridView>
                            <GridViewColumn Header="{DynamicResource FileColumn}" Width="{Binding PartsFileColumnWith, FallbackValue=560}"><GridViewColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" IsReadOnly="True" materialDesign:HintAssist.Hint="{DynamicResource ModelPath}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding FilePath}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Click="BrowsePartClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button></Grid></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{DynamicResource SettingsColumn}" Width="{Binding PartsSettingsWidth, FallbackValue=420}"><GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource ParentBoneName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding ParentBoneTag, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Margin="0,6,0,0" Height="38" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.PartTypeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Type, Mode=TwoWay}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{DynamicResource SortColumn}" Width="{Binding PartsSortWidth, FallbackValue=220}"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowUpBold}" ToolTip="{DynamicResource TipMoveUp}" Command="{Binding MoveUpCommand}"/><Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowDownBold}" ToolTip="{DynamicResource TipMoveDown}" Command="{Binding MoveDownCommand}"/><Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=Delete}" ToolTip="{DynamicResource TipDelete}" Command="{Binding DeleteCommand}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        </GridView></ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Grid>
    </materialDesign:DialogHost>
</Window>
