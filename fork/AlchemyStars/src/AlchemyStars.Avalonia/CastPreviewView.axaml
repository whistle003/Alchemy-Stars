<UserControl x:Class="AlchemyStars.Avalonia.CastPreviewView"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlchemyStars.Avalonia" x:DataType="local:CastPreviewViewModel">
  <Grid RowDefinitions="*,56">
    <Grid ColumnDefinitions="40,*">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Background="{DynamicResource AlchemySurfaceBrush}" IsEnabled="{Binding HasScene}">
          <ToggleButton Classes="preview-command compact-preview-command" IsChecked="{Binding IsFirstPerson, Mode=OneWay}" Click="FirstPersonClick"
              ToolTip.Tip="{Binding CameraModeLabel}" AutomationProperties.Name="{Binding CameraModeLabel}">
            <Grid>
              <Path Classes="icon-glyph preview-icon" IsVisible="{Binding !IsFirstPerson}" IsHitTestVisible="False" Data="M3,6 L7,6 L9,4 L14,4 L16,6 L18,6 L18,16 L3,16 Z M10.5,8 A3,3 0 1,0 10.5,14 A3,3 0 1,0 10.5,8" />
              <Path Classes="icon-glyph preview-icon accent" IsVisible="{Binding IsFirstPerson}" IsHitTestVisible="False" Data="M3,6 L7,6 L9,4 L14,4 L16,6 L18,6 L18,16 L3,16 Z M10.5,8 A3,3 0 1,0 10.5,14 A3,3 0 1,0 10.5,8" />
            </Grid>
          </ToggleButton>
          <Button x:Name="FitButton" Classes="panel-command compact-preview-command" Click="FitClick" ToolTip.Tip="{Binding Text.FitPreview}" AutomationProperties.Name="{Binding Text.FitPreview}"><Button.ContextMenu><ContextMenu><MenuItem Header="{Binding Text.FitSubjectMenu}" Click="FitClick" /><MenuItem Header="{Binding Text.FitAllGeometryMenu}" Click="FitAllClick" /></ContextMenu></Button.ContextMenu><Path Classes="icon-glyph preview-icon" Data="M3,8 L3,3 L8,3 M12,3 L17,3 L17,8 M17,12 L17,17 L12,17 M8,17 L3,17 L3,12" /></Button>
          <Button Classes="panel-command compact-preview-command" IsEnabled="{Binding CanAdjustCamera}" Click="ZoomInClick" ToolTip.Tip="{Binding Text.ZoomIn}" AutomationProperties.Name="{Binding Text.ZoomIn}"><Path Classes="icon-glyph preview-icon" Data="M10,3 L10,17 M3,10 L17,10" /></Button>
          <Button Classes="panel-command compact-preview-command" IsEnabled="{Binding CanAdjustCamera}" Click="ZoomOutClick" ToolTip.Tip="{Binding Text.ZoomOut}" AutomationProperties.Name="{Binding Text.ZoomOut}"><Path Classes="icon-glyph preview-icon" Stretch="None" Data="M3,10 L17,10" /></Button>
          <Button Classes="panel-command compact-preview-command" Click="BonesClick" ToolTip.Tip="{Binding Text.ShowBones}" AutomationProperties.Name="{Binding Text.ShowBones}"><Path Classes="icon-glyph preview-icon" Data="M4,4 L10,10 L16,5 M10,10 L15,17 M2,2 L6,2 L6,6 L2,6 Z M14,3 L18,3 L18,7 L14,7 Z M13,15 L17,15 L17,19 L13,19 Z" /></Button>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="Viewport" Grid.Column="1" Background="#10151C" Focusable="True" ClipToBounds="True"
          SizeChanged="ViewportSizeChanged" PointerPressed="ViewportPressed" PointerMoved="ViewportMoved" PointerReleased="ViewportReleased"
          PointerWheelChanged="ViewportWheel" KeyDown="ViewportKeyDown" ToolTip.Tip="{Binding InteractionHelp}"
          AutomationProperties.Name="{Binding InteractionHelp}">
        <Grid>
          <local:GpuCastPreviewControl Frame="{Binding FrameData}" IsVisible="{Binding HasScene}" AutomationProperties.Name="{Binding Status}" />
          <StackPanel IsVisible="{Binding !HasScene}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Spacing="14">
            <Image Source="avares://AlchemyStars.Avalonia/Assets/AlchemyStarsIcon.png" Width="52" Height="52" Stretch="Uniform" />
            <TextBlock Text="{Binding Status}" TextAlignment="Center" TextWrapping="Wrap" Classes="muted" MaxWidth="400" />
          </StackPanel>
          <Border VerticalAlignment="Bottom" Padding="7,3" Background="#BB10151C" IsVisible="{Binding HasScene}" IsHitTestVisible="False">
            <TextBlock Text="{Binding Source}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Border>
          <Border VerticalAlignment="Top" Padding="7,3" Background="#9910151C" IsVisible="{Binding HasScene}" IsHitTestVisible="False">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="preview-badge compact-preview-badge" Margin="7,0,0,0" IsVisible="{Binding IsFirstPerson}">
                <TextBlock Text="{Binding FirstPersonBadge}" Foreground="{DynamicResource AlchemyAccentBrush}" FontSize="10" FontWeight="SemiBold" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource AlchemySurfaceBrush}" BorderBrush="{DynamicResource AlchemyBorderBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="24,32">
        <Slider x:Name="FrameSlider" Classes="preview-scrubber" Minimum="0" Maximum="{Binding LastFrame}"
          Value="{Binding Frame}" SmallChange="1" IsSnapToTickEnabled="True" TickPlacement="TopLeft"
          TickFrequency="{Binding PreviewTickFrequency}" Margin="10,-2,10,0"
          IsEnabled="{Binding CanPlay}" AutomationProperties.Name="{Binding Text.PreviewFrame}">
        <Slider.Resources>
          <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
          <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
          <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
          <x:Double x:Key="SliderOutsideTickBarThemeHeight">6</x:Double>
          <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
          <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF4CC2FF" />
          <SolidColorBrush x:Key="SliderTickBarFill" Color="#FF73767C" />
        </Slider.Resources>
        </Slider>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
          <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanPlay}">
            <Button Classes="panel-command preview-transport-command" Click="PreviousClick" ToolTip.Tip="{Binding Text.PreviousFrame}" AutomationProperties.Name="{Binding Text.PreviousFrame}"><Path Classes="icon-glyph transport-icon" Data="M4,3 L4,17 M16,3 L7,10 L16,17 Z" /></Button>
            <Button Classes="panel-command preview-transport-command" Click="PlayClick" ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}"><Grid><Path Classes="icon-glyph transport-icon" IsVisible="{Binding !IsPlaying}" Data="M5,3 L17,10 L5,17 Z" /><Path Classes="icon-glyph transport-icon" IsVisible="{Binding IsPlaying}" Data="M6,3 L6,17 M14,3 L14,17" /></Grid></Button>
            <Button Classes="panel-command preview-transport-command" Click="NextClick" ToolTip.Tip="{Binding Text.NextFrame}" AutomationProperties.Name="{Binding Text.NextFrame}"><Path Classes="icon-glyph transport-icon" Data="M16,3 L16,17 M4,3 L13,10 L4,17 Z" /></Button>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding FrameLabel}" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0"
              VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{Binding Status}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
