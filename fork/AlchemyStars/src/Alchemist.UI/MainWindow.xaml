<Window x:Class="Alchemist.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Alchemist.UI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        Title="{Binding Title}" KeyDown="WindowKeyDown" SizeChanged="WindowSizeChanged" Loaded="WindowLoaded" AutomationProperties.AutomationId="MainWindow"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Height="768" Width="1366" MinHeight="520" MinWidth="900">
    <Window.Resources>
        <Style x:Key="PathBrowseButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ToolTip" Value="{DynamicResource Browse}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="TopBarIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="ToolTipService.ShowDuration" Value="6000"/>
        </Style>
        <Style x:Key="TopBarIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AlchemyMutedSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EditablePathTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <EventSetter Event="LostFocus" Handler="PathTextBoxLostFocus"/>
            <EventSetter Event="PreviewDragOver" Handler="PathTextBoxPreviewDragOver"/>
            <EventSetter Event="PreviewDrop" Handler="PathTextBoxPreviewDrop"/>
        </Style>
        <Style x:Key="RowTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="RowComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,8"/></Style></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IkFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldLabel}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OutputFormatOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="FormatBorder" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="SelectionIcon" Kind="RadioboxBlank" Width="18" Height="18" Foreground="{DynamicResource MaterialDesignBody}"/>
                                <ContentPresenter Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionIcon" Property="Kind" Value="RadioboxMarked"/>
                                <Setter TargetName="SelectionIcon" Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                <Setter TargetName="FormatBorder" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                <Setter TargetName="FormatBorder" Property="Background" Value="{DynamicResource AlchemyMutedSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FormatBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="FormatBorder" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost DialogClosing="DialogHostDialogClosing"
                               OpenDialogCommandDataContextSource="DialogHostInstance"
                               DialogTheme="Inherit" Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition MinWidth="0"/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions>
                <ToolBarTray IsLocked="True" Grid.Column="0">
                    <ToolBar ClipToBounds="True" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ToolBarTray}}"
                             AutomationProperties.AutomationId="MainToolbar" Style="{StaticResource MaterialDesignToolBar}" KeyboardNavigation.TabNavigation="Continue">
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipLoadProject}" AutomationProperties.Name="{DynamicResource TipLoadProject}" AutomationProperties.AutomationId="OpenProjectButton" Command="{Binding ImportProjectCommand}">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipSaveProject}" AutomationProperties.Name="{DynamicResource TipSaveProject}" AutomationProperties.AutomationId="SaveProjectButton" Command="{Binding SaveProjectCommand}">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipSaveProjectAs}" AutomationProperties.Name="{DynamicResource TipSaveProjectAs}" AutomationProperties.AutomationId="SaveProjectAsButton" Command="{Binding SaveProjectAsCommand}">
                        <materialDesign:PackIcon Kind="ContentSaveEditOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Separator/>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipAddAnimations}" AutomationProperties.Name="{DynamicResource TipAddAnimations}" AutomationProperties.AutomationId="AddAnimationsButton" Command="{Binding AddAnimationsCommand}">
                        <materialDesign:PackIcon Kind="AnimationPlusOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipExportAnimations}" AutomationProperties.Name="{DynamicResource TipExportAnimations}" AutomationProperties.AutomationId="ExportAnimationsButton" Command="{Binding SaveAnimationsCommand}">
                        <materialDesign:PackIcon Kind="FileExportOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipRemoveAnimations}" AutomationProperties.Name="{DynamicResource TipRemoveAnimations}" AutomationProperties.AutomationId="RemoveAnimationsButton" Command="{Binding RemoveAnimationsCommand}">
                        <materialDesign:PackIcon Kind="AnimationMinusOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipOutputFolder}" AutomationProperties.Name="{DynamicResource TipOutputFolder}" AutomationProperties.AutomationId="OutputFolderButton" Command="{Binding SetOutputFolderCommand}">
                        <materialDesign:PackIcon Kind="FolderCogOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Separator/>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipEnableLeftIK}" AutomationProperties.Name="{DynamicResource TipEnableLeftIK}" AutomationProperties.AutomationId="EnableLeftIkButton" Command="{Binding ToggleLeftHandIKCommand}" CommandParameter="Enable">
                        <Grid Width="28" Height="22"><materialDesign:PackIcon Kind="VectorPolylinePlus" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Text="L" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipEnableRightIK}" AutomationProperties.Name="{DynamicResource TipEnableRightIK}" AutomationProperties.AutomationId="EnableRightIkButton" Command="{Binding ToggleRightHandIKCommand}" CommandParameter="Enable">
                        <Grid Width="28" Height="22"><materialDesign:PackIcon Kind="VectorPolylinePlus" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Text="R" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipDisableLeftIK}" AutomationProperties.Name="{DynamicResource TipDisableLeftIK}" AutomationProperties.AutomationId="DisableLeftIkButton" Command="{Binding ToggleLeftHandIKCommand}" CommandParameter="Disable">
                        <Grid Width="28" Height="22"><materialDesign:PackIcon Kind="VectorPolylineMinus" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Text="L" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipDisableRightIK}" AutomationProperties.Name="{DynamicResource TipDisableRightIK}" AutomationProperties.AutomationId="DisableRightIkButton" Command="{Binding ToggleRightHandIKCommand}" CommandParameter="Disable">
                        <Grid Width="28" Height="22"><materialDesign:PackIcon Kind="VectorPolylineMinus" Width="22" Height="22" HorizontalAlignment="Left"/><TextBlock Text="R" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
                    </Button>
                    <Separator/>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipAddPrefix}" AutomationProperties.Name="{DynamicResource TipAddPrefix}" AutomationProperties.AutomationId="AddPrefixButton"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" materialDesign:DialogHost.DialogClosingAttached="DialogHostDialogClosing">
                        <Button.Content><materialDesign:PackIcon Kind="FormatLetterStartsWith" Style="{StaticResource TopBarIcon}"/></Button.Content>
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="320">
                                <TextBlock Text="{DynamicResource AddPrefixPrompt}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBox x:Name="PrefixBox" Margin="0,12,0,0"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Accept}" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="AcceptPrefix"/>
                                    <Button Margin="8,0,0,0" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Cancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                                </StackPanel>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipAddSuffix}" AutomationProperties.Name="{DynamicResource TipAddSuffix}" AutomationProperties.AutomationId="AddSuffixButton"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" materialDesign:DialogHost.DialogClosingAttached="DialogHostDialogClosing">
                        <Button.Content><materialDesign:PackIcon Kind="FormatLetterEndsWith" Style="{StaticResource TopBarIcon}"/></Button.Content>
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="320">
                                <TextBlock Text="{DynamicResource AddSuffixPrompt}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBox x:Name="SuffixBox" Margin="0,12,0,0"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Accept}" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="AcceptSuffix"/>
                                    <Button Margin="8,0,0,0" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Cancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                                </StackPanel>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipSetLeftPose}" AutomationProperties.Name="{DynamicResource TipSetLeftPose}" AutomationProperties.AutomationId="SetLeftPoseButton" Command="{Binding SetPoseFileCommand}" CommandParameter="Left">
                        <materialDesign:PackIcon Kind="HandBackLeftOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipSetRightPose}" AutomationProperties.Name="{DynamicResource TipSetRightPose}" AutomationProperties.AutomationId="SetRightPoseButton" Command="{Binding SetPoseFileCommand}" CommandParameter="Right">
                        <materialDesign:PackIcon Kind="HandBackRightOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Separator/>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipAddLayers}" AutomationProperties.Name="{DynamicResource TipAddLayers}" AutomationProperties.AutomationId="AddLayersButton" Command="{Binding AddLayerCommand}">
                        <materialDesign:PackIcon Kind="LayersPlus" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipRemoveLayers}" AutomationProperties.Name="{DynamicResource TipRemoveLayers}" AutomationProperties.AutomationId="RemoveLayersButton" Command="{Binding RemoveLayerCommand}">
                        <materialDesign:PackIcon Kind="LayersMinus" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Separator/>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipAddParts}" AutomationProperties.Name="{DynamicResource TipAddParts}" AutomationProperties.AutomationId="AddPartsButton" Command="{Binding AddPartsCommand}">
                        <materialDesign:PackIcon Kind="BoxPlusOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipRemoveParts}" AutomationProperties.Name="{DynamicResource TipRemoveParts}" AutomationProperties.AutomationId="RemovePartsButton" Command="{Binding RemovePartsCommand}">
                        <materialDesign:PackIcon Kind="BoxMinusOutline" Style="{StaticResource TopBarIcon}"/>
                    </Button>
                    <Separator/>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipSettings}" AutomationProperties.Name="{DynamicResource TipSettings}" AutomationProperties.AutomationId="SettingsButton" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                        <Button.Content><materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource TopBarIcon}"/></Button.Content>
                        <Button.CommandParameter>
                            <Border x:Name="SettingsDialogBorder" Width="840" Height="620"
                                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Padding="24,20" Background="{DynamicResource MaterialDesignPaper}"
                                    AutomationProperties.AutomationId="SettingsDialog">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="TuneVariant" Width="24" Height="24" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SettingsSubtitle}" Margin="0,3,0,0" Opacity="0.72" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <TabControl Grid.Row="1" AutomationProperties.AutomationId="SettingsTabs" KeyboardNavigation.TabNavigation="Continue">
                                        <TabItem Header="{DynamicResource OutputSettingsTab}" AutomationProperties.AutomationId="OutputSettingsTab">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <Grid Margin="4,12,12,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <Border Style="{StaticResource SettingsCard}">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource OutputFormatSection}" FontSize="15" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{DynamicResource DefaultOutputFormat}" Style="{StaticResource SettingsFieldLabel}" Margin="0,12,0,4"/>
                                                                <UniformGrid Columns="2" Rows="2" KeyboardNavigation.TabNavigation="Continue">
                                                                    <RadioButton Content=".cast" Tag=".cast" GroupName="DefaultOutputFormat"
                                                                                 AutomationProperties.AutomationId="CastOutputFormatRadioButton"
                                                                                 AutomationProperties.Name=".cast"
                                                                                 Style="{StaticResource OutputFormatOption}"
                                                                                 IsChecked="{Binding IsCastOutput, Mode=OneWay}"
                                                                                 Checked="OutputFormatOptionChecked"/>
                                                                    <RadioButton Content=".fbx" Tag=".fbx" GroupName="DefaultOutputFormat"
                                                                                 AutomationProperties.AutomationId="FbxOutputFormatRadioButton"
                                                                                 AutomationProperties.Name=".fbx"
                                                                                 Style="{StaticResource OutputFormatOption}"
                                                                                 IsChecked="{Binding IsFbxOutput, Mode=OneWay}"
                                                                                 Checked="OutputFormatOptionChecked"/>
                                                                    <RadioButton Content=".smd" Tag=".smd" GroupName="DefaultOutputFormat"
                                                                                 AutomationProperties.AutomationId="SmdOutputFormatRadioButton"
                                                                                 AutomationProperties.Name=".smd"
                                                                                 Style="{StaticResource OutputFormatOption}"
                                                                                 IsChecked="{Binding IsSmdOutput, Mode=OneWay}"
                                                                                 Checked="OutputFormatOptionChecked"/>
                                                                    <RadioButton Content=".seanim" Tag=".seanim" GroupName="DefaultOutputFormat"
                                                                                 AutomationProperties.AutomationId="SeanimOutputFormatRadioButton"
                                                                                 AutomationProperties.Name=".seanim"
                                                                                 Style="{StaticResource OutputFormatOption}"
                                                                                 IsChecked="{Binding IsSeanimOutput, Mode=OneWay}"
                                                                                 Checked="OutputFormatOptionChecked"/>
                                                                </UniformGrid>
                                                                <TextBlock Text="{DynamicResource OutputFormatHelp}" Margin="0,6,0,0" Opacity="0.72" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource FileNamingSection}" FontSize="15" FontWeight="SemiBold"/>
                                                                <Grid Margin="0,12,0,0">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,6,0">
                                                                        <TextBlock Text="{DynamicResource OutputPrefix}" Style="{StaticResource SettingsFieldLabel}"/>
                                                                        <TextBox AutomationProperties.Name="{DynamicResource OutputPrefix}" Style="{StaticResource SettingsTextBox}" Text="{Binding OutputPrefix}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                        <TextBlock Text="{DynamicResource OutputSuffix}" Style="{StaticResource SettingsFieldLabel}"/>
                                                                        <TextBox AutomationProperties.Name="{DynamicResource OutputSuffix}" Style="{StaticResource SettingsTextBox}" Text="{Binding OutputSuffix}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <Border Style="{StaticResource SettingsCard}">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource OutputBehaviorSection}" FontSize="15" FontWeight="SemiBold"/>
                                                                <CheckBox x:Name="CastAnimationOnlyCheckBox"
                                                                          AutomationProperties.AutomationId="CastAnimationOnlyCheckBox"
                                                                          AutomationProperties.Name="{DynamicResource CastAnimationOnly}"
                                                                          Content="{DynamicResource CastAnimationOnly}"
                                                                          IsChecked="{Binding CastAnimationOnly}"
                                                                          IsEnabled="{Binding IsCastOutput}"
                                                                          MinHeight="44" Margin="0,6,0,0"
                                                                          Checked="CastAnimationOnlyChanged"
                                                                          Unchecked="CastAnimationOnlyChanged"/>
                                                                <TextBlock Text="{DynamicResource CastAnimationOnlyHelp}" Margin="28,0,0,8" Opacity="0.72" TextWrapping="Wrap"/>
                                                                <CheckBox x:Name="BakeRelevantBonesOnlyCheckBox"
                                                                          AutomationProperties.AutomationId="BakeRelevantBonesOnlyCheckBox"
                                                                          AutomationProperties.Name="{DynamicResource BakeRelevantBonesOnly}"
                                                                          Content="{DynamicResource BakeRelevantBonesOnly}"
                                                                          IsChecked="{Binding BakeRelevantBonesOnly}"
                                                                          MinHeight="44"
                                                                          Checked="BakeRelevantBonesOnlyChanged"
                                                                          Unchecked="BakeRelevantBonesOnlyChanged"/>
                                                                <TextBlock Text="{DynamicResource BakeRelevantBonesOnlyHelp}" Margin="28,0,0,0" Opacity="0.72" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource CompatibilitySection}" FontSize="15" FontWeight="SemiBold"/>
                                                                <CheckBox Content="{DynamicResource MatchOldCod}" AutomationProperties.Name="{DynamicResource MatchOldCod}" IsChecked="{Binding MatchOldCallOfDuty}" MinHeight="44" Margin="0,6,0,0"/>
                                                                <TextBlock Text="{DynamicResource FbxMayaRequirement}" Margin="0,4,0,0" Opacity="0.72" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource IkSettingsTab}" AutomationProperties.AutomationId="IkSettingsTab">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="4,12,12,8">
                                                    <TextBlock Text="{DynamicResource IkSettingsHelp}" Opacity="0.72" TextWrapping="Wrap" Margin="4,0,4,12"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource SettingsCard}" Margin="0,0,6,0">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                <materialDesign:PackIcon Kind="HandBackLeftOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{DynamicResource LeftHandIkSection}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                                                    <TextBlock x:Name="LeftIkStartLabel" AutomationProperties.AutomationId="LeftIkStartLabel" Text="{DynamicResource DefaultLeftIKStart}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="LeftIkStartTextBox" AutomationProperties.AutomationId="LeftIkStartTextBox" AutomationProperties.Name="{DynamicResource DefaultLeftIKStart}" Style="{StaticResource SettingsTextBox}" Text="{Binding LeftIKStartBoneName}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                                                                    <TextBlock x:Name="LeftIkMiddleLabel" AutomationProperties.AutomationId="LeftIkMiddleLabel" Text="{DynamicResource DefaultLeftIKMiddle}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="LeftIkMiddleTextBox" AutomationProperties.AutomationId="LeftIkMiddleTextBox" AutomationProperties.Name="{DynamicResource DefaultLeftIKMiddle}" Style="{StaticResource SettingsTextBox}" Text="{Binding LeftIKMidBoneName}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                                                                    <TextBlock x:Name="LeftIkEndLabel" AutomationProperties.AutomationId="LeftIkEndLabel" Text="{DynamicResource DefaultLeftIKEnd}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="LeftIkEndTextBox" AutomationProperties.AutomationId="LeftIkEndTextBox" AutomationProperties.Name="{DynamicResource DefaultLeftIKEnd}" Style="{StaticResource SettingsTextBox}" Text="{Binding LeftIKEndBoneName}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,0,0">
                                                                    <TextBlock x:Name="LeftIkTargetLabel" AutomationProperties.AutomationId="LeftIkTargetLabel" Text="{DynamicResource DefaultLeftIKTarget}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="LeftIkTargetTextBox" AutomationProperties.AutomationId="LeftIkTargetTextBox" AutomationProperties.Name="{DynamicResource DefaultLeftIKTarget}" Style="{StaticResource SettingsTextBox}" Text="{Binding LeftIKTargetBoneName}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource SettingsCard}" Margin="6,0,0,0">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                <materialDesign:PackIcon Kind="HandBackRightOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{DynamicResource RightHandIkSection}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                                                    <TextBlock x:Name="RightIkStartLabel" AutomationProperties.AutomationId="RightIkStartLabel" Text="{DynamicResource DefaultRightIKStart}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="RightIkStartTextBox" AutomationProperties.AutomationId="RightIkStartTextBox" AutomationProperties.Name="{DynamicResource DefaultRightIKStart}" Style="{StaticResource SettingsTextBox}" Text="{Binding RightIKStartBoneName}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                                                                    <TextBlock x:Name="RightIkMiddleLabel" AutomationProperties.AutomationId="RightIkMiddleLabel" Text="{DynamicResource DefaultRightIKMiddle}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="RightIkMiddleTextBox" AutomationProperties.AutomationId="RightIkMiddleTextBox" AutomationProperties.Name="{DynamicResource DefaultRightIKMiddle}" Style="{StaticResource SettingsTextBox}" Text="{Binding RightIKMidBoneName}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                                                                    <TextBlock x:Name="RightIkEndLabel" AutomationProperties.AutomationId="RightIkEndLabel" Text="{DynamicResource DefaultRightIKEnd}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="RightIkEndTextBox" AutomationProperties.AutomationId="RightIkEndTextBox" AutomationProperties.Name="{DynamicResource DefaultRightIKEnd}" Style="{StaticResource SettingsTextBox}" Text="{Binding RightIKEndBoneName}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,0,0">
                                                                    <TextBlock x:Name="RightIkTargetLabel" AutomationProperties.AutomationId="RightIkTargetLabel" Text="{DynamicResource DefaultRightIKTarget}" Style="{StaticResource IkFieldLabel}"/>
                                                                    <TextBox x:Name="RightIkTargetTextBox" AutomationProperties.AutomationId="RightIkTargetTextBox" AutomationProperties.Name="{DynamicResource DefaultRightIKTarget}" Style="{StaticResource SettingsTextBox}" Text="{Binding RightIKTargetBoneName}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>
                                    </TabControl>
                                    <Button Grid.Row="2" Margin="0,12,0,0" MinWidth="72" Height="44" HorizontalAlignment="Right"
                                            AutomationProperties.AutomationId="SettingsCloseButton" AutomationProperties.Name="{DynamicResource Close}"
                                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Close}"
                                            IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="CloseSettings"/>
                                </Grid>
                            </Border>
                        </Button.CommandParameter>
                    </Button>
                    <Button Style="{StaticResource TopBarIconButton}" ToolTip="{DynamicResource TipExperimental}" AutomationProperties.Name="{DynamicResource TipExperimental}" AutomationProperties.AutomationId="ExperimentalScriptsButton" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" materialDesign:DialogHost.DialogClosing="DialogHostDialogClosing">
                        <Button.Content><materialDesign:PackIcon Kind="ScriptTextPlayOutline" Style="{StaticResource TopBarIcon}"/></Button.Content>
                        <Button.CommandParameter>
                            <StackPanel Margin="20" Width="280">
                                <TextBlock Text="{DynamicResource ScriptsTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ListBox x:Name="ScriptsListBox" Background="#30000000" SelectionMode="Multiple" ItemsSource="{Binding Scripts}" Height="192"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Run}" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Run"/>
                                    <Button Margin="8,0,0,0" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="{DynamicResource Close}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" CommandParameter="Decline"/>
                                </StackPanel>
                            </StackPanel>
                        </Button.CommandParameter>
                    </Button>
                    </ToolBar>
                </ToolBarTray>
                <Border Grid.Column="1" Panel.ZIndex="2" Background="{DynamicResource MaterialDesignPaper}" Padding="6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="LanguageButton" Padding="8,0" ToolTip="{DynamicResource TipLanguage}" AutomationProperties.Name="{DynamicResource TipLanguage}" AutomationProperties.AutomationId="LanguageButton" Click="OpenLanguageMenuClick" Width="112" Height="44" Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource FollowSystemLanguage}" Tag="system" IsCheckable="True" Click="SetLanguageClick" AutomationProperties.AutomationId="SystemLanguageMenuItem"/>
                                    <Separator/>
                                    <MenuItem Header="简体中文" Tag="zh-CN" IsCheckable="True" Click="SetLanguageClick" AutomationProperties.AutomationId="ChineseLanguageMenuItem"/>
                                    <MenuItem Header="English" Tag="en-US" IsCheckable="True" Click="SetLanguageClick" AutomationProperties.AutomationId="EnglishLanguageMenuItem"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TranslateVariant" Width="20" Height="20"/><TextBlock Text="{Binding LanguageModeLabel}" Margin="6,0,4,0" VerticalAlignment="Center"/><materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="AboutButton" Padding="10" ToolTip="{DynamicResource TipAbout}" AutomationProperties.Name="{DynamicResource TipAbout}" AutomationProperties.AutomationId="AboutButton" Click="OpenAboutClick" Width="44" Height="44" Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:PackIcon Kind="InformationSlabCircleOutline" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryDark" Style="{StaticResource MaterialDesignFilledTabControl}">
                <TabItem Header="{DynamicResource AnimationsTab}" AutomationProperties.AutomationId="AnimationsTab">
                    <Grid>
                    <ListView x:Name="MainAnimationList" AutomationProperties.AutomationId="AnimationList" Visibility="{Binding IsVisible}" ItemsSource="{Binding Animations}" Background="#20000000" AllowDrop="True" Drop="ListViewDrop" SelectionChanged="ListViewSelectionChanged" PreviewMouseRightButtonUp="ImportSurfacePreviewMouseRightButtonUp" PreviewKeyDown="ImportSurfacePreviewKeyDown" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource ContextImportAnimations}" AutomationProperties.Name="{DynamicResource ContextImportAnimations}" AutomationProperties.AutomationId="ImportAnimationsContextMenuItem" Command="{Binding DataContext.AddAnimationsCommand}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="AnimationPlusOutline" Width="20" Height="20"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignGridViewItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource FileColumn}" Width="{Binding FileColumnWith}">
                                    <GridViewColumn.CellTemplate><DataTemplate><StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" AutomationProperties.AutomationId="AnimationPathTextBox" AutomationProperties.Name="{DynamicResource AnimationPath}" materialDesign:HintAssist.Hint="{DynamicResource AnimationPath}" Style="{StaticResource EditablePathTextBox}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Click="BrowseAnimationClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" AutomationProperties.AutomationId="LeftPosePathTextBox" AutomationProperties.Name="{DynamicResource LeftPosePath}" materialDesign:HintAssist.Hint="{DynamicResource LeftPosePath}" Style="{StaticResource EditablePathTextBox}" Text="{Binding LeftHandPoseFile, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Left" Click="BrowsePoseClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button><Button Grid.Column="2" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Left" Click="ClearPoseClick" ToolTip="{DynamicResource TipDelete}"><materialDesign:PackIcon Kind="Close" Width="20" Height="20"/></Button></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" AutomationProperties.AutomationId="RightPosePathTextBox" AutomationProperties.Name="{DynamicResource RightPosePath}" materialDesign:HintAssist.Hint="{DynamicResource RightPosePath}" Style="{StaticResource EditablePathTextBox}" Text="{Binding RightHandPoseFile, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Right" Click="BrowsePoseClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button><Button Grid.Column="2" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Tag="Right" Click="ClearPoseClick" ToolTip="{DynamicResource TipDelete}"><materialDesign:PackIcon Kind="Close" Width="20" Height="20"/></Button></Grid>
                                    </StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource IKSettingsColumn}" Width="{Binding IKSettingsColumnWith}">
                                    <GridViewColumn.CellTemplate><DataTemplate><StackPanel>
                                        <TextBlock Text="{DynamicResource LeftIKTargetOverride}" TextWrapping="Wrap" Style="{StaticResource SettingsFieldLabel}" Margin="0,8,0,4"/>
                                        <TextBox AutomationProperties.Name="{DynamicResource LeftIKTargetOverride}" Style="{StaticResource SettingsTextBox}" Text="{Binding LeftIKTargetBoneName}"/>
                                        <TextBlock Text="{DynamicResource RightIKTargetOverride}" TextWrapping="Wrap" Style="{StaticResource SettingsFieldLabel}" Margin="0,8,0,4"/>
                                        <TextBox AutomationProperties.Name="{DynamicResource RightIKTargetOverride}" Style="{StaticResource SettingsTextBox}" Text="{Binding RightIKTargetBoneName}"/>
                                        <CheckBox MinHeight="32" Margin="0,8,0,0" Content="{DynamicResource EnableLeftHand}" IsChecked="{Binding EnableLeftHandIK}"/>
                                        <CheckBox MinHeight="32" Content="{DynamicResource EnableRightHand}" IsChecked="{Binding EnableRightHandIK}"/>
                                    </StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource LayersColumn}" Width="{Binding LayersColumnWith, FallbackValue=600}">
                                    <GridViewColumn.CellTemplate><DataTemplate><Grid><ListBox Height="244" ItemsSource="{Binding Layers}" Background="#20000000" SelectionMode="Extended" SelectionChanged="ListBoxSelectionChanged" AutomationProperties.AutomationId="LayerList" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext}">
                                        <ListBox.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource ContextImportLayers}" AutomationProperties.Name="{DynamicResource ContextImportLayers}" AutomationProperties.AutomationId="ImportLayersContextMenuItem" Command="{Binding Tag.AddLayersForAnimationCommand}" CommandParameter="{Binding DataContext}">
                                                    <MenuItem.Icon><materialDesign:PackIcon Kind="LayersPlus" Width="20" Height="20"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="{DynamicResource AlchemyMutedSurfaceBrush}"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                    <TextBox AutomationProperties.AutomationId="LayerPathTextBox" AutomationProperties.Name="{DynamicResource LayerPath}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" materialDesign:HintAssist.Hint="{DynamicResource LayerPath}" Style="{StaticResource EditablePathTextBox}" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Style="{StaticResource PathBrowseButton}" ToolTip="{DynamicResource ContextImportLayers}" Click="BrowseLayerClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                                                    <ComboBox AutomationProperties.AutomationId="LayerTypeComboBox" AutomationProperties.Name="{DynamicResource LayerType}" Style="{StaticResource RowComboBox}" Margin="0,0,6,0" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.LayerTypeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Type, Mode=TwoWay}"/>
                                                    <TextBox Grid.Column="1" Margin="0,0,6,0" materialDesign:HintAssist.Hint="{DynamicResource Offset}" Style="{StaticResource RowTextBox}" Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowUpBold}" ToolTip="{DynamicResource TipMoveUp}" Command="{Binding MoveUpCommand}"/>
                                                        <Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowDownBold}" ToolTip="{DynamicResource TipMoveDown}" Command="{Binding MoveDownCommand}"/>
                                                        <Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=DeleteOutline}" ToolTip="{DynamicResource TipDelete}" Command="{Binding DeleteCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{DynamicResource EmptyLayersHelp}" AutomationProperties.AutomationId="EmptyLayersHint" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="24" Opacity="0.78" IsHitTestVisible="False">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Layers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    </Grid></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource OutputColumn}" Width="{Binding OutputColumnWith}">
                                    <GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource OutputName}" Style="{StaticResource RowTextBox}" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" AutomationProperties.AutomationId="OutputFolderTextBox" AutomationProperties.Name="{DynamicResource OutputFolder}" materialDesign:HintAssist.Hint="{DynamicResource OutputFolder}" Style="{StaticResource EditablePathTextBox}" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Click="BrowseOutputFolderClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button></Grid><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource OutputFramerate}" Style="{StaticResource RowTextBox}" Text="{Binding OutputFramerate, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="{DynamicResource ExperimentalFeatures}" IsChecked="{Binding UseExperimentalFeatures}" Margin="0,12,0,0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24,60,24,24">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Animations.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="{DynamicResource EmptyAnimations}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource EmptyAnimationsHelp}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Opacity="0.78"/>
                    </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource PartsTab}" AutomationProperties.AutomationId="PartsTab">
                    <Grid>
                    <ListView x:Name="MainModelList" AutomationProperties.AutomationId="ModelPartsList" Visibility="{Binding IsVisible}" ItemsSource="{Binding Parts}" Background="#20000000" SelectionChanged="ListViewSelectionChanged" AllowDrop="True" Drop="ModelListDrop" PreviewMouseRightButtonUp="ImportSurfacePreviewMouseRightButtonUp" PreviewKeyDown="ImportSurfacePreviewKeyDown" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource ContextImportParts}" AutomationProperties.Name="{DynamicResource ContextImportParts}" AutomationProperties.AutomationId="ImportPartsContextMenuItem" Command="{Binding DataContext.AddPartsCommand}">
                                    <MenuItem.Icon><materialDesign:PackIcon Kind="BoxPlusOutline" Width="20" Height="20"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignGridViewItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                        <ListView.View><GridView>
                            <GridViewColumn Header="{DynamicResource FileColumn}" Width="{Binding PartsFileColumnWith, FallbackValue=560}"><GridViewColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox Margin="0,4,4,0" AutomationProperties.AutomationId="ModelPathTextBox" AutomationProperties.Name="{DynamicResource ModelPath}" materialDesign:HintAssist.Hint="{DynamicResource ModelPath}" Style="{StaticResource EditablePathTextBox}" Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource PathBrowseButton}" Click="BrowsePartClick"><materialDesign:PackIcon Kind="FolderSearchOutline" Width="20" Height="20"/></Button></Grid></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{DynamicResource SettingsColumn}" Width="{Binding PartsSettingsWidth, FallbackValue=420}"><GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBox Margin="0,4,0,0" materialDesign:HintAssist.Hint="{DynamicResource ParentBoneName}" Style="{StaticResource RowTextBox}" Text="{Binding ParentBoneTag, UpdateSourceTrigger=PropertyChanged}"/><ComboBox AutomationProperties.Name="{DynamicResource PartType}" Style="{StaticResource RowComboBox}" Margin="0,6,0,0" MinHeight="44" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.PartTypeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Type, Mode=TwoWay}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{DynamicResource SortColumn}" Width="{Binding PartsSortWidth, FallbackValue=220}"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowUpBold}" ToolTip="{DynamicResource TipMoveUp}" Command="{Binding MoveUpCommand}"/><Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=ArrowDownBold}" ToolTip="{DynamicResource TipMoveDown}" Command="{Binding MoveDownCommand}"/><Button Style="{StaticResource PathBrowseButton}" Content="{materialDesign:PackIcon Kind=Delete}" ToolTip="{DynamicResource TipDelete}" Command="{Binding DeleteCommand}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        </GridView></ListView.View>
                    </ListView>
                    <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24,60,24,24">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Parts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="{DynamicResource EmptyParts}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource EmptyPartsHelp}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Opacity="0.78"/>
                    </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </materialDesign:DialogHost>
</Window>
