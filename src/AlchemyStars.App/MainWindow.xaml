<Window x:Class="AlchemyStars.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Alchemy Stars"
        Width="1260" Height="840" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Color x:Key="BackgroundColor">#0F172A</Color>
        <Color x:Key="SurfaceColor">#151F33</Color>
        <Color x:Key="SurfaceRaisedColor">#1B273C</Color>
        <Color x:Key="MutedColor">#273449</Color>
        <Color x:Key="BorderColor">#475569</Color>
        <Color x:Key="ForegroundColor">#F8FAFC</Color>
        <Color x:Key="SubtleTextColor">#A8B5C8</Color>
        <Color x:Key="AccentColor">#22C55E</Color>
        <Color x:Key="AccentHoverColor">#36D770</Color>
        <Color x:Key="AccentPressedColor">#16A34A</Color>
        <Color x:Key="InfoColor">#60A5FA</Color>
        <Color x:Key="WarningColor">#FBBF24</Color>
        <Color x:Key="DangerColor">#F87171</Color>

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{StaticResource MutedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#07140C" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Polygon Points="20,1 27,13 39,20 27,27 20,39 13,27 1,20 13,13"
                             Fill="{StaticResource AccentBrush}" />
                    <Ellipse Width="10" Height="10" Fill="{StaticResource BackgroundBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ALCHEMY STARS" FontSize="21" FontWeight="Bold" />
                    <TextBlock Text="CAST 动画合成与 Maya 2025 烘焙工作台" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#182E28" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="等待检查" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,22,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="合成任务" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="选择通用主动画和可选 Additive 层；预设可在冲刺与 Idle 之间快速切换。"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="13" Margin="0,5,0,18" />

                        <TextBlock Text="输出预设" Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox x:Name="AnimationModeCombo" SelectionChanged="AnimationModeCombo_SelectionChanged"
                                  AutomationProperties.Name="输出预设">
                            <ComboBoxItem Tag="Sprint" IsSelected="True">冲刺循环 + 单帧偏移层（推荐）</ComboBoxItem>
                            <ComboBoxItem Tag="Idle">Idle 单动画</ComboBoxItem>
                        </ComboBox>

                        <Separator Margin="0,18" Background="{StaticResource BorderBrush}" />

                        <TextBlock Text="模型输入" Style="{StaticResource SectionLabelStyle}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                            <TextBlock Text="手臂模型" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="ArmsPathTextBox" Grid.Column="1" AutomationProperties.Name="手臂 CAST 文件路径" />
                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Tag="Arms" Click="BrowseCast_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                            <TextBlock Text="武器模型" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="WeaponPathTextBox" Grid.Column="1" AutomationProperties.Name="武器 CAST 文件路径" />
                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Tag="Weapon" Click="BrowseCast_Click" />
                        </Grid>

                        <TextBlock Text="动画输入" Style="{StaticResource SectionLabelStyle}" Margin="0,6,0,7" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                            <TextBlock Text="冲刺循环" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="SprintPathTextBox" Grid.Column="1" AutomationProperties.Name="冲刺循环 CAST 文件路径" />
                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Tag="Sprint" Click="BrowseCast_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                            <TextBlock Text="偏移层" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="OffsetPathTextBox" Grid.Column="1" AutomationProperties.Name="Additive 偏移 CAST 文件路径" />
                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Tag="Offset" Click="BrowseCast_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Idle 动画" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="IdlePathTextBox" Grid.Column="1" AutomationProperties.Name="Idle CAST 文件路径" />
                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Tag="Idle" Click="BrowseCast_Click" />
                        </Grid>

                        <TextBlock Text="输出" Style="{StaticResource SectionLabelStyle}" Margin="0,6,0,7" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                            <TextBlock Text="CAST 包" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox x:Name="OutputPathTextBox" Grid.Column="1" AutomationProperties.Name="输出 CAST 文件路径" />
                            <Button Grid.Column="2" Content="另存为" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                        </Grid>

                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13,8" Margin="0,2,0,14">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="LeftIkCheckBox" Content="烘焙左手 IK" IsChecked="True" Margin="0,0,26,0" />
                                <CheckBox x:Name="RightIkCheckBox" Content="烘焙右手 IK（循环目标将自动跳过）" IsChecked="False" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="AnalyzeButton" Content="检查输入" Style="{StaticResource ButtonStyle}" Click="AnalyzeButton_Click" />
                            <Button x:Name="BakeButton" Grid.Column="2" Content="开始烘焙唯一动画" Style="{StaticResource PrimaryButtonStyle}" Click="BakeButton_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="输入检查" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="AnalysisSummaryText" Text="尚未分析" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap" />
                        <UniformGrid Columns="2" Rows="3">
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,6,6">
                                <StackPanel><TextBlock x:Name="CombinedBonesText" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="合并骨骼" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="6,0,0,6">
                                <StackPanel><TextBlock x:Name="TargetBonesText" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="动画目标" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,6,6,6">
                                <StackPanel><TextBlock x:Name="FrameRangeText" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="帧范围" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="6,6,0,6">
                                <StackPanel><TextBlock x:Name="FpsText" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="FPS" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,6,6,0">
                                <StackPanel><TextBlock x:Name="MissingTargetsText" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="缺失目标" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="6,6,0,0">
                                <StackPanel><TextBlock x:Name="IkChainsText" Text="—" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="IK 链就绪" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/></StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Maya 2025" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="MayaStatusText" Text="正在检测本机 Maya…" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,5,0,13" TextWrapping="Wrap" />
                        <Button Content="安装 / 更新 CAST 插件" Style="{StaticResource ButtonStyle}" Click="InstallMayaPlugin_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="任务状态" FontSize="17" FontWeight="SemiBold" />
                        <ProgressBar x:Name="BakeProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource MutedBrush}" Margin="0,14,0,12" />
                        <TextBlock x:Name="TaskStatusText" Text="填写或确认路径，然后检查输入。" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        <Button x:Name="OpenOutputButton" Content="在资源管理器中显示产物" Style="{StaticResource ButtonStyle}" Margin="0,14,0,0" Click="OpenOutput_Click" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock Text="输出结构：2 个模型根 · 1 个动画根 · 全绝对曲线 · Maya 导入顺序无关" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="v1.0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
